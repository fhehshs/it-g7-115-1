[{"id": 1, "chapter": "封面", "title": "物聯網 IoT 與 AIoT", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>📡</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>物聯網 IoT 與 AIoT</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Internet of Things &amp; AIoT</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📶 感測與連線</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🏷️ RFID</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🏙️ 智慧城市</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 2 週</p>\n</div>"}, {"id": 2, "chapter": "第一節：什麼是物聯網", "title": "物聯網是什麼？", "bg": "white", "quiz": null, "chart": null, "video": {"query": "物聯網 IoT 是什麼 中文 介紹", "title": "延伸影片：物聯網是什麼？", "desc": "在 YouTube 搜尋「物聯網 IoT 介紹」，挑一支 3–5 分鐘的中文短片"}, "html": "\n<h2 class='slide-title'>物聯網是什麼？把日常物品連上網路</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.93rem;'>📖 把任何裝置、交通工具、建築物<strong>連上網際網路</strong>，讓它們藉由<strong>感測器互相交換資料、自動完成任務</strong>。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.8rem;'>📡</div><strong style='color:#1e40af;font-size:.88rem;'>感測 Sense</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.6;'>感測器蒐集溫度、光線、位置等環境資料</p></div>\n  <div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.8rem;'>💬</div><strong style='color:#166534;font-size:.88rem;'>溝通 Connect</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.6;'>裝置之間透過網路自動傳送訊息</p></div>\n  <div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.8rem;'>🎮</div><strong style='color:#854d0e;font-size:.88rem;'>控制 Control</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.6;'>從任何地方遠端操控設備</p></div>\n  <div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.8rem;'>📊</div><strong style='color:#5b21b6;font-size:.88rem;'>學習 Learn</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.6;'>分析行為模式，提供個人化服務</p></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>💬 <strong>一句話記住</strong>：以前是「人上網」，現在是「<strong>物也上網</strong>」。你的悠遊卡、電子看板、超商冰箱，都在默默傳資料。</p>\n</div>\n<div id='video-section-2' class='video-section'></div>"}, {"id": 3, "chapter": "第一節：什麼是物聯網", "title": "IoT 的三層架構", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>IoT 怎麼運作？三層架構一次看懂</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <div style='display:flex;flex-direction:column;gap:10px;'>\n    <div style='background:rgba(59,130,246,.2);border-left:4px solid #3b82f6;border-radius:8px;padding:12px 16px;'>\n      <strong style='color:#93c5fd;font-size:.92rem;'>① 感知層（Perception）— 裝置的「五官」</strong>\n      <p style='color:#cbd5e1;font-size:.8rem;margin-top:4px;'>溫濕度感測器、攝影機、GPS、RFID 標籤、麥克風 → 把真實世界變成數字</p>\n    </div>\n    <div style='text-align:center;color:#64748b;font-size:1.1rem;'>&#8595;</div>\n    <div style='background:rgba(13,148,136,.2);border-left:4px solid #0d9488;border-radius:8px;padding:12px 16px;'>\n      <strong style='color:#5eead4;font-size:.92rem;'>② 網路層（Network）— 資料的「高速公路」</strong>\n      <p style='color:#cbd5e1;font-size:.8rem;margin-top:4px;'>Wi-Fi、藍牙、4G／5G、LoRa → 把資料送到雲端伺服器</p>\n    </div>\n    <div style='text-align:center;color:#64748b;font-size:1.1rem;'>&#8595;</div>\n    <div style='background:rgba(168,85,247,.2);border-left:4px solid #a855f7;border-radius:8px;padding:12px 16px;'>\n      <strong style='color:#d8b4fe;font-size:.92rem;'>③ 應用層（Application）— 你看得到的「服務」</strong>\n      <p style='color:#cbd5e1;font-size:.8rem;margin-top:4px;'>手機 App、儀表板、自動控制指令 → 智慧家庭、公車動態、健康報告</p>\n    </div>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🚌 <strong>用公車動態站牌驗證</strong>：公車上的 GPS（感知層）→ 4G 回傳位置（網路層）→ 站牌與 App 顯示「還有 3 分鐘」（應用層）。</p>\n</div>"}, {"id": 4, "chapter": "第一節：什麼是物聯網", "title": "IoT 應用無所不在", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>IoT 應用無所不在</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🏠</div><strong style='color:#1e40af;font-size:.88rem;'>智慧家庭</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>語音控制電器、自動空調、智慧冰箱、遠端監控</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🏥</div><strong style='color:#166534;font-size:.88rem;'>智慧醫療</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>穿戴裝置監測心率、遠距問診、跌倒偵測</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🌾</div><strong style='color:#854d0e;font-size:.88rem;'>智慧農業</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>土壤濕度感測、自動灌溉、無人機巡田</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🚦</div><strong style='color:#5b21b6;font-size:.88rem;'>智慧交通</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>公車動態、YouBike 車柱、即時路況、智慧停車</p></div>\n  <div style='background:#ecfeff;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🏭</div><strong style='color:#155e75;font-size:.88rem;'>工業物聯網</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>機台預測性維護、生產線監控、良率分析</p></div>\n  <div style='background:#fef2f2;padding:13px;border-radius:10px;'>\n    <div style='font-size:1.5rem;'>🌪️</div><strong style='color:#991b1b;font-size:.88rem;'>防災監測</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>河川水位、雨量站、地震速報、空品測站</p></div>\n</div>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>🇹🇼 <strong>台灣在地案例</strong>：<strong>YouBike</strong> 每個車柱都會回報有沒有車，App 才能顯示「剩 3 台」；<strong>環境部空氣品質監測網</strong>把全台測站資料即時公開，你查得到現在的 PM2.5。這兩個都是你天天在用的 IoT。</p>\n</div>"}, {"id": 5, "chapter": "第一節：什麼是物聯網", "title": "智慧家庭", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🏠 智慧家庭 — 家裡的每個角落都在思考</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#fff7ed;padding:13px;border-radius:10px;border-left:4px solid #f97316;'>\n    <strong style='color:#9a3412;font-size:.87rem;'>🍚 智慧電子鍋</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>依你設定的口感煮飯，回家前先煮好</p></div>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;border-left:4px solid #3b82f6;'>\n    <strong style='color:#1e40af;font-size:.87rem;'>❄️ 智慧空調</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>連結天氣預報，進門前先調好溫度</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;border-left:4px solid #16a34a;'>\n    <strong style='color:#166534;font-size:.87rem;'>🧊 智慧冰箱</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>監控食物狀態、提醒過期、建議菜單</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;border-left:4px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:.87rem;'>🔌 智慧插座</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>遠端關掉忘記拔的電器、記錄用電</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;border-left:4px solid #a855f7;'>\n    <strong style='color:#5b21b6;font-size:.87rem;'>💨 智慧空氣清淨機</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>偵測 PM2.5 與油煙，自動加強運轉</p></div>\n  <div style='background:#ecfeff;padding:13px;border-radius:10px;border-left:4px solid #06b6d4;'>\n    <strong style='color:#155e75;font-size:.87rem;'>📺 聲控電視</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>找不到遙控器？直接說話換台</p></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>💬 <strong>討論</strong>：如果你家有一個電器可以升級成「智慧」版，你會選哪一個？它要解決你什麼困擾？（想不到困擾＝可能不需要升級，這也是個好答案）</p>\n</div>"}, {"id": 6, "chapter": "第一節：什麼是物聯網", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>物聯網的定義與運作 ｜ 3 題</p>\n</div>"}, {"id": 7, "chapter": "第二節：RFID 與感測器", "title": "RFID 射頻識別", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🏷️ RFID — 不用碰就能讀取</h2>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#94a3b8;font-size:.82rem;margin-bottom:12px;'>Radio Frequency Identification（射頻識別）— 用無線電波隔空讀取資料</p>\n  <div style='display:flex;align-items:center;justify-content:space-between;gap:8px;'>\n    <div style='background:rgba(59,130,246,.2);border-radius:10px;padding:12px;flex:1;text-align:center;'>\n      <div style='font-size:1.6rem;'>🏷️</div>\n      <strong style='color:#93c5fd;font-size:.85rem;'>① 標籤 Tag</strong>\n      <p style='color:#cbd5e1;font-size:.72rem;margin-top:4px;'>貼在物品上，儲存識別碼</p></div>\n    <div style='color:#f59e0b;font-size:1.3rem;'>&#8644;</div>\n    <div style='background:rgba(245,158,11,.2);border-radius:10px;padding:12px;flex:1;text-align:center;'>\n      <div style='font-size:1.6rem;'>📶</div>\n      <strong style='color:#fbbf24;font-size:.85rem;'>② 無線電波</strong>\n      <p style='color:#cbd5e1;font-size:.72rem;margin-top:4px;'>不需接觸、不需對準</p></div>\n    <div style='color:#f59e0b;font-size:1.3rem;'>&#8644;</div>\n    <div style='background:rgba(13,148,136,.2);border-radius:10px;padding:12px;flex:1;text-align:center;'>\n      <div style='font-size:1.6rem;'>📟</div>\n      <strong style='color:#5eead4;font-size:.85rem;'>③ 讀取器 Reader</strong>\n      <p style='color:#cbd5e1;font-size:.72rem;margin-top:4px;'>接收、解讀並上傳系統</p></div>\n  </div>\n</div>\n<div style='display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:11px;border-radius:9px;text-align:center;'><div style='font-size:1.4rem;'>🚇</div><p style='font-size:.74rem;color:#334155;margin-top:3px;'>悠遊卡<br>門禁卡</p></div>\n  <div style='background:#f0fdf4;padding:11px;border-radius:9px;text-align:center;'><div style='font-size:1.4rem;'>🚗</div><p style='font-size:.74rem;color:#334155;margin-top:3px;'>ETC<br>車輛識別</p></div>\n  <div style='background:#fefce8;padding:11px;border-radius:9px;text-align:center;'><div style='font-size:1.4rem;'>✈️</div><p style='font-size:.74rem;color:#334155;margin-top:3px;'>行李<br>追蹤</p></div>\n  <div style='background:#f5f3ff;padding:11px;border-radius:9px;text-align:center;'><div style='font-size:1.4rem;'>📚</div><p style='font-size:.74rem;color:#334155;margin-top:3px;'>圖書館<br>借還書</p></div>\n  <div style='background:#fef2f2;padding:11px;border-radius:9px;text-align:center;'><div style='font-size:1.4rem;'>📦</div><p style='font-size:.74rem;color:#334155;margin-top:3px;'>倉儲<br>盤點</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎫 <strong>算算看</strong>：你今天用了幾次 RFID？（進校門、搭公車、超商買東西、圖書館借書…）多數人一天至少 5 次卻完全沒感覺——這就是好的科技。</p>\n</div>"}, {"id": 8, "chapter": "第二節：RFID 與感測器", "title": "常見感測器", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔬 常見感測器 — IoT 的五官</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:22%;'>感測器</th>\n    <th style='padding:7px;text-align:left;width:30%;'>測什麼</th>\n    <th style='padding:7px;text-align:left;'>你身邊的例子</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>🌡️ 溫濕度感測器</td><td style='padding:7px;'>溫度、相對濕度</td><td style='padding:7px;'>冷氣、除濕機、氣象站、農業溫室</td></tr>\n  <tr><td style='padding:7px;'>💡 光感測器</td><td style='padding:7px;'>環境亮度</td><td style='padding:7px;'>手機自動調亮度、智慧路燈、自動窗簾</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📍 GPS 定位模組</td><td style='padding:7px;'>經緯度、移動速度</td><td style='padding:7px;'>導航、公車動態、運動手錶記錄路線</td></tr>\n  <tr><td style='padding:7px;'>🏃 加速度計／陀螺儀</td><td style='padding:7px;'>移動、傾斜、旋轉</td><td style='padding:7px;'>手機轉向、計步、跌倒偵測、遊戲控制</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>👋 紅外線／超音波</td><td style='padding:7px;'>有沒有人、距離多遠</td><td style='padding:7px;'>自動門、自動水龍頭、掃地機器人避障</td></tr>\n  <tr><td style='padding:7px;'>🌫️ 空品感測器</td><td style='padding:7px;'>PM2.5、二氧化碳</td><td style='padding:7px;'>空氣清淨機、教室 CO₂ 監測、環境測站</td></tr>\n</table>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>📱 <strong>驚人事實</strong>：你口袋裡那支手機，就內建了上面表格中<strong>至少五種感測器</strong>。它其實是一台被你握在手裡的 IoT 裝置。</p>\n</div>"}, {"id": 9, "chapter": "第二節：RFID 與感測器", "title": "IoT 用了多少裝置", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📈 全世界有多少台裝置連著網路？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;'>\n  <div style='background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:#fff;border-radius:12px;padding:18px;text-align:center;'>\n    <div style='font-size:2.1rem;font-weight:900;'>約 211 億</div>\n    <p style='font-size:.8rem;opacity:.9;margin-top:6px;'>2025 年底全球連網 IoT 裝置數<br>（IoT Analytics 估計）</p></div>\n  <div style='background:linear-gradient(135deg,#065f46,#0d9488);color:#fff;border-radius:12px;padding:18px;text-align:center;'>\n    <div style='font-size:2.1rem;font-weight:900;'>+14%</div>\n    <p style='font-size:.8rem;opacity:.9;margin-top:6px;'>2025 年較前一年的成長率<br>（2024 年約 185 億台）</p></div>\n  <div style='background:linear-gradient(135deg,#6b21a8,#a855f7);color:#fff;border-radius:12px;padding:18px;text-align:center;'>\n    <div style='font-size:2.1rem;font-weight:900;'>約 390 億</div>\n    <p style='font-size:.8rem;opacity:.9;margin-top:6px;'>2030 年預測值<br>（預測值會隨情勢調整）</p></div>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:13px 16px;margin-bottom:12px;'>\n  <p style='color:#334155;font-size:.87rem;margin:0;line-height:1.9;'>\n    🌍 全球人口約 80 億，也就是說<strong>平均每個人身邊有 2–3 台連網的「物」</strong>。而你自己可能就佔了好幾台：手機、手錶、耳機、電視、遊戲機……</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>🔍 <strong>看數據要看來源</strong>：不同研究機構算出的數字會不一樣（有的把手機算進去、有的不算）。做報告時，<strong>一定要寫出「誰統計的、哪一年」</strong>——這是第 10–12 週專題的評分重點之一。</p>\n</div>"}, {"id": 10, "chapter": "第二節：RFID 與感測器", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>RFID 與感測器 ｜ 3 題</p>\n</div>"}, {"id": 11, "chapter": "第三節：AIoT 與智慧城市", "title": "AI + IoT = AIoT", "bg": "white", "quiz": null, "chart": null, "video": {"query": "AIoT 人工智慧物聯網 是什麼 中文", "title": "延伸影片：什麼是 AIoT？", "desc": "在 YouTube 搜尋「AIoT 人工智慧物聯網」，看看業界怎麼應用"}, "html": "\n<h2 class='slide-title'>🤖 AI ＋ IoT ＝ AIoT：聰明的東西會自己做事</h2>\n<div style='display:flex;align-items:stretch;gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;flex:1;'>\n    <div style='background:#2563eb;color:#fff;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-bottom:8px;'>1</div>\n    <strong style='color:#1e40af;font-size:.9rem;'>IoT 收集資料</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>感測器持續蒐集溫度、位置、使用行為</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.4rem;'>&#8594;</div>\n  <div style='background:#f5f3ff;border-radius:12px;padding:15px;flex:1;'>\n    <div style='background:#7c3aed;color:#fff;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-bottom:8px;'>2</div>\n    <strong style='color:#5b21b6;font-size:.9rem;'>AI 分析決策</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>從資料中找出規律，判斷「現在該做什麼」</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.4rem;'>&#8594;</div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;flex:1;'>\n    <div style='background:#16a34a;color:#fff;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;margin-bottom:8px;'>3</div>\n    <strong style='color:#166534;font-size:.9rem;'>自動化行動</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>裝置自己執行，並持續學習修正</p></div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:12px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    ⚖️ <strong style='color:#fbbf24;'>一句話分辨</strong>：<br>\n    只會「回報數字、等你按開關」→ <strong>IoT</strong>　｜　會「自己找規律、自己決定」→ <strong>AIoT</strong></p>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎬 <strong>真實例子</strong>：串流平台記錄你看了什麼、看到第幾分鐘跳過（IoT 式的資料收集），再用 AI 推薦下一部片。它不是「懂你」，它是「算出來的」。</p>\n</div>\n<div id='video-section-11' class='video-section'></div>"}, {"id": 12, "chapter": "第三節：AIoT 與智慧城市", "title": "智慧城市與 5G", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🏙️ 智慧城市與 5G — 城市怎麼變聰明</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <h3 style='color:#1e40af;font-size:1rem;margin-bottom:8px;'>📶 5G 帶來的兩個關鍵改變</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li><strong>低延遲</strong>：指令送出到收到回應的時間大幅縮短，自駕車、遠距手術才可行</li>\n      <li><strong>高連線密度</strong>：同一個區域能同時容納更多裝置，一座城市數十萬個感測器才連得上</li>\n      <li><strong>高頻寬</strong>：即時傳送高畫質影像，AI 影像辨識才有材料可用</li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>🏗️ 城市裡的 AIoT 應用</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li><strong>交通</strong>：分析車流自動調整號誌時相，降低壅塞</li>\n      <li><strong>節能</strong>：智慧路燈依人車流量調整亮度</li>\n      <li><strong>防災</strong>：水位／雨量測站即時預警，提早疏散</li>\n      <li><strong>環境</strong>：空品微型感測器找出污染熱點</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🇹🇼 <strong>台北在地</strong>：<strong>臺北市政府資料大平臺</strong>把公車動態、YouBike 站點、空氣品質、停車位資訊開放給大家使用——很多你在用的 App，資料其實都來自這裡。第 3 週我們就會實際打開它看看。</p>\n</div>"}, {"id": 13, "chapter": "第三節：AIoT 與智慧城市", "title": "校園裡的 IoT", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>🏫 找找看：我們學校裡的 IoT</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>🚪</div><strong style='color:#fff;font-size:.86rem;'>門禁與刷卡機</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>RFID 感應，紀錄進出時間</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>🌡️</div><strong style='color:#fff;font-size:.86rem;'>教室冷氣管控</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>集中控制、定時關機、用電統計</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>📺</div><strong style='color:#fff;font-size:.86rem;'>電子公告看板</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>從網路更新內容，不用重印海報</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>💧</div><strong style='color:#fff;font-size:.86rem;'>飲水機濾心提示</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>計算流量，提醒何時該換濾心</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>📚</div><strong style='color:#fff;font-size:.86rem;'>圖書館借還書</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>RFID 標籤，一次感應多本書</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.4rem;'>🔦</div><strong style='color:#fff;font-size:.86rem;'>感應式照明／水龍頭</strong>\n    <p style='color:#ccfbf1;font-size:.75rem;margin-top:5px;line-height:1.6;'>紅外線偵測有人才啟動，省電省水</p></div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:12px 18px;'>\n  <p style='color:#f0fdfa;font-size:.89rem;margin:0;line-height:1.85;'>\n    🔎 <strong>下課走一圈</strong>：找出三個校園裡「有感測、有連線」的東西，拍照記錄。想想看——如果再幫學校加一個 IoT 裝置，你會加什麼？</p>\n</div>"}, {"id": 14, "chapter": "第三節：AIoT 與智慧城市", "title": "想像未來智慧生活", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>💡 想像未來智慧生活 — 三個範例點子</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;border-top:5px solid #2563eb;'>\n    <div style='font-size:1.8rem;'>🎒</div>\n    <strong style='color:#1e40af;font-size:.95rem;'>智慧書包</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'><strong>感測</strong>：重量感測器＋RFID 標籤<br><strong>解決</strong>：對照課表，提醒今天課本有沒有帶齊、書包會不會太重</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:16px;border-top:5px solid #16a34a;'>\n    <div style='font-size:1.8rem;'>👟</div>\n    <strong style='color:#166534;font-size:.95rem;'>智慧鞋墊</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'><strong>感測</strong>：壓力感測器＋加速度計<br><strong>解決</strong>：記錄步數與走路姿勢，提醒運動量並預防運動傷害</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:16px;border-top:5px solid #eab308;'>\n    <div style='font-size:1.8rem;'>💡</div>\n    <strong style='color:#854d0e;font-size:.95rem;'>智慧桌燈</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'><strong>感測</strong>：光感測器＋距離感測器<br><strong>解決</strong>：自動調亮度與色溫，趴太近時提醒你坐正，保護視力</p></div>\n</div>\n<div style='background:#f5f3ff;padding:12px 16px;border-radius:8px;border-left:4px solid #7c3aed;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;line-height:1.85;'>✏️ <strong>換你想</strong>：好的 IoT 點子都長這樣 ——<br>\n  「<strong>誰</strong>遇到<strong>什麼困擾</strong> → 需要知道<strong>什麼資料</strong> → 用<strong>什麼感測器</strong>量 → 裝置<strong>自動做什麼</strong>」。等一下的分組實作就照這個公式寫。</p>\n</div>"}, {"id": 15, "chapter": "第三節：AIoT 與智慧城市", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>AIoT 與智慧城市 ｜ 3 題</p>\n</div>"}, {"id": 16, "chapter": "第四節：IoT 的另一面", "title": "IoT 的資安風險", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>⚠️ IoT 的另一面：越方便，破口越多</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-top:5px solid #dc2626;'>\n    <h3 style='color:#991b1b;font-size:1rem;margin-bottom:8px;'>🔓 常見資安風險</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li><strong>預設密碼沒改</strong>：admin／123456 是駭客第一個試的</li>\n      <li><strong>韌體不更新</strong>：舊漏洞一直留著沒補</li>\n      <li><strong>裝置被綁架</strong>：被組成殭屍網路去攻擊別人</li>\n      <li><strong>攝影機外洩</strong>：家中畫面被公開在網路上</li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-top:5px solid #16a34a;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>🛡️ 買回家的第一件事</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li><strong>立刻改掉預設密碼</strong>，用長一點的密碼</li>\n      <li><strong>開啟自動更新</strong>韌體</li>\n      <li><strong>只給必要權限</strong>，不需要定位就別開</li>\n      <li>攝影機<strong>不要對著臥室、書桌</strong>；不用時關掉</li>\n      <li>買<strong>有在維護、會發布更新</strong>的品牌</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🧠 <strong>核心觀念</strong>：IoT 裝置也是一台<strong>連在你家網路上的小電腦</strong>。你會幫電腦設密碼、更新系統，就該用同樣的態度對待它。第 5、6 週會把這件事講得更清楚。</p>\n</div>"}, {"id": 17, "chapter": "第四節：IoT 的另一面", "title": "IoT 的隱私問題", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔍 IoT 的隱私問題：它知道的比你以為的多</h2>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.9rem;font-weight:700;margin-bottom:10px;'>一支智慧手環，可以推論出關於你的哪些事？</p>\n  <div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;'>\n    <div style='background:rgba(255,255,255,.08);border-radius:8px;padding:11px;'>\n      <p style='color:#e2e8f0;font-size:.82rem;margin:0;'>💤 <strong>睡眠資料</strong> → 幾點睡、幾點起、睡得好不好</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:8px;padding:11px;'>\n      <p style='color:#e2e8f0;font-size:.82rem;margin:0;'>📍 <strong>位置紀錄</strong> → 家在哪、學校在哪、常去哪</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:8px;padding:11px;'>\n      <p style='color:#e2e8f0;font-size:.82rem;margin:0;'>❤️ <strong>心率變化</strong> → 運動習慣，甚至情緒與健康狀況</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:8px;padding:11px;'>\n      <p style='color:#e2e8f0;font-size:.82rem;margin:0;'>🚶 <strong>活動模式</strong> → 你今天有沒有去上學、幾點回家</p></div>\n  </div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>📜 在台灣，<strong>《個人資料保護法》</strong>把「病歷、醫療、健康檢查」等列為<strong>特種個資</strong>，蒐集與利用有更嚴格的限制。使用穿戴裝置前，值得花兩分鐘看它的隱私權政策。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🤔 <strong>沒有標準答案的問題</strong>：為了更方便、更安全，你願意讓多少資料被記錄？如果學校要用手環記錄全校學生的作息以「關心健康」，你贊成嗎？</p>\n</div>"}, {"id": 18, "chapter": "第四節：IoT 的另一面", "title": "科技的兩面", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>⚖️ 每一項 IoT 應用，都有兩面</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:24%;'>應用</th>\n    <th style='padding:7px;text-align:left;'>👍 帶來什麼好處</th>\n    <th style='padding:7px;text-align:left;'>👎 可能的代價</th></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'><strong>智慧路口監視</strong></td><td style='padding:7px;'>找回走失老人、追查肇事逃逸</td><td style='padding:7px;'>行蹤被完整記錄，被監控的感受</td></tr>\n  <tr><td style='padding:7px;'><strong>智慧電表</strong></td><td style='padding:7px;'>看得到用電習慣、可以省錢省電</td><td style='padding:7px;'>用電曲線可推測家中有沒有人在</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'><strong>校園刷卡系統</strong></td><td style='padding:7px;'>快速點名、家長知道孩子安全到校</td><td style='padding:7px;'>學生每天的行動被完整記錄</td></tr>\n  <tr><td style='padding:7px;'><strong>智慧音箱</strong></td><td style='padding:7px;'>語音操作方便，長輩與身障者受惠</td><td style='padding:7px;'>需要持續聆聽喚醒詞，錄音疑慮</td></tr>\n</table>\n<div style='background:#f5f3ff;padding:12px 16px;border-radius:8px;border-left:4px solid #7c3aed;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;line-height:1.85;'>\n    💬 <strong>Group Talk</strong>：選一列，分組討論「如果是你，你會裝嗎？要加上什麼條件才願意裝？」<br>\n    <span style='color:#64748b;font-size:.84rem;'>沒有標準答案，但要說得出理由——這正是第 4 週「安全 vs. 隱私」的預習。</span></p>\n</div>"}, {"id": 19, "chapter": "第四節：IoT 的另一面", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>IoT 的資安與隱私 ｜ 3 題</p>\n</div>"}, {"id": 20, "chapter": "分組實作", "title": "分組實作：設計你的 IoT 裝置", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎯 分組實作：合作共創簡報「我設計的 IoT 裝置」</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#1e40af;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📋 用 Google 簡報共同編輯，每組至少 3 頁</p>\n  <div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#2563eb;font-size:.85rem;'>Q1 · 第 1 頁</strong>\n      <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>用<strong>自己的話</strong>說明 IoT 或 AIoT 是什麼，可以舉例。不要抄定義。</p></div>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#2563eb;font-size:.85rem;'>Q2 · 第 2 頁</strong>\n      <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>舉一個<strong>生活中真實存在</strong>的 IoT 應用，說明它的優點<strong>和缺點</strong>。</p></div>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#2563eb;font-size:.85rem;'>Q3 · 第 3 頁</strong>\n      <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>設計一個<strong>全新的</strong> IoT 裝置：解決誰的什麼問題？用什麼感測器？怎麼運作？</p></div>\n  </div>\n</div>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'>\n  <div style='background:#f0fdf4;border-radius:10px;padding:14px;'>\n    <strong style='color:#166534;font-size:.9rem;'>✅ 加分項目</strong>\n    <ul style='color:#334155;font-size:.8rem;line-height:1.85;padding-left:18px;margin:6px 0 0;'>\n      <li>畫出裝置草圖或流程圖（手繪拍照也可以）</li>\n      <li>誠實說出你的設計可能帶來的<strong>隱私或資安疑慮</strong></li>\n      <li>圖片使用免費授權素材並註明來源</li>\n    </ul>\n  </div>\n  <div style='background:#fffbeb;border-radius:10px;padding:14px;'>\n    <strong style='color:#92400e;font-size:.9rem;'>📏 評分（規準一）</strong>\n    <p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'>\n      <strong style='color:#059669;'>A</strong> 三題完整、整合多元資料且表達正確<br>\n      <strong style='color:#2563eb;'>B</strong> 三題完成、表達正確<br>\n      <strong style='color:#d97706;'>C</strong> 引導下完成主要內容<br>\n      <strong style='color:#dc2626;'>D</strong> 僅完成部分內容</p>\n  </div>\n</div>"}, {"id": 21, "chapter": "分組實作", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 2 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>IoT 物聯網</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>物品連上網路，能感測、溝通、控制、學習——三層架構：感知／網路／應用</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>RFID 射頻識別</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>無線電波隔空讀取，悠遊卡就是；標籤＋讀取器兩件套</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>AIoT</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>IoT 蒐集資料 ＋ AI 分析決策；分辨關鍵是「會不會自己越用越懂你」</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>兩面性</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>每個便利背後都有隱私與資安代價；買回家先改預設密碼</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>IoT 每天產生的資料多到裝不下——那要放到哪裡？</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：大數據與雲端運算</p>\n</div>"}]