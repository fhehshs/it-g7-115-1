[{"id": 1, "chapter": "封面", "title": "新興議題專題報告製作", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>📊</div>\n  <h1 style='font-size:2.5rem;font-weight:900;color:#fff;margin-bottom:10px;'>新興議題專題報告製作</h1>\n  <h2 style='font-size:1.18rem;font-weight:400;color:#93c5fd;margin-bottom:22px;'>Project-Based Learning on Emerging Technology</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🎯 選題</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔍 查證</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🎨 設計</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🤝 分工</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 10–12 週</p>\n</div>"}, {"id": 2, "chapter": "第一節：選題與提問", "title": "這三週要做什麼", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🗺️ 這三週要做什麼？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;border-top:5px solid #2563eb;'>\n    <strong style='color:#1e40af;font-size:1rem;'>第 10 週</strong>\n    <p style='font-size:.79rem;color:#64748b;margin:3px 0 8px;'>定題與蒐集</p>\n    <ul style='color:#475569;font-size:.79rem;line-height:1.85;padding-left:18px;margin:0;'>\n      <li>分組、決定主題與核心問題</li>\n      <li>完成<strong>專題企劃表</strong></li>\n      <li>蒐集資料並建立素材清單</li>\n    </ul></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-top:5px solid #16a34a;'>\n    <strong style='color:#166534;font-size:1rem;'>第 11 週</strong>\n    <p style='font-size:.79rem;color:#64748b;margin:3px 0 8px;'>製作初稿</p>\n    <ul style='color:#475569;font-size:.79rem;line-height:1.85;padding-left:18px;margin:0;'>\n      <li>把內容整理成簡報架構</li>\n      <li>製作圖表、繪製示意圖</li>\n      <li>完成 <strong>6 頁以上初稿</strong>，交給老師看</li>\n    </ul></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;border-top:5px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:1rem;'>第 12 週</strong>\n    <p style='font-size:.79rem;color:#64748b;margin:3px 0 8px;'>修改與定稿</p>\n    <ul style='color:#475569;font-size:.79rem;line-height:1.85;padding-left:18px;margin:0;'>\n      <li>依老師與同儕的建議修改</li>\n      <li>補上資料來源頁與 AI 使用聲明</li>\n      <li>分配發表段落並<strong>試講一次</strong></li>\n    </ul></div>\n</div>\n<div style='background:#f5f3ff;padding:12px 16px;border-radius:8px;border-left:4px solid #7c3aed;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎤 <strong>第 13–14 週</strong>：成果發表。每組上台 5 分鐘，含同儕互評與個人學習歷程心得。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>⏰ <strong>最重要的一句話</strong>：<strong>第 11 週一定要生出初稿</strong>。有初稿才能修改，沒有初稿就只能在最後一刻硬做——那是拿不到好成績的做法。</p>\n</div>"}, {"id": 3, "chapter": "第一節：選題與提問", "title": "可以選什麼主題", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>💡 可以選什麼主題？（回顧這學期的七大議題）</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.86rem;'>📡 物聯網 IoT</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>智慧家庭、智慧農業、穿戴裝置、校園應用</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.86rem;'>📊 大數據</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>開放資料、健保資料庫、交通流量分析</p></div>\n  <div style='background:#ecfeff;padding:13px;border-radius:10px;'>\n    <strong style='color:#155e75;font-size:.86rem;'>☁️ 雲端運算</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>雲端協作、資料中心耗電、線上學習</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#5b21b6;font-size:.86rem;'>🤖 AI 與機器學習</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>生成式 AI、醫療 AI、自駕車、AI 與工作</p></div>\n  <div style='background:#fef2f2;padding:13px;border-radius:10px;'>\n    <strong style='color:#991b1b;font-size:.86rem;'>🔒 資訊安全</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>詐騙手法演變、勒索軟體、密碼安全</p></div>\n  <div style='background:#fff7ed;padding:13px;border-radius:10px;'>\n    <strong style='color:#9a3412;font-size:.86rem;'>👤 個資與隱私</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>數位足跡、人臉辨識、監視器爭議</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.86rem;'>⚖️ 資訊倫理</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>Deepfake、AI 著作權、演算法偏見</p></div>\n  <div style='background:#f1f5f9;padding:13px;border-radius:10px;border:2px dashed #94a3b8;'>\n    <strong style='color:#334155;font-size:.86rem;'>🔀 跨主題組合</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:4px;line-height:1.65;'>例如「智慧校園的便利與隱私」（IoT＋個資）</p></div>\n</div>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🇹🇼 <strong>加分方向</strong>：如果你的主題能連結到<strong>台灣或台北在地</strong>的例子（YouBike、健保、開放資料、學校的實際狀況），內容會立刻變得具體有說服力。</p>\n</div>"}, {"id": 4, "chapter": "第一節：選題與提問", "title": "從大題目縮成好題目", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔭 從「大題目」縮成「好題目」</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <div style='display:flex;align-items:center;gap:9px;flex-wrap:wrap;'>\n    <div style='background:rgba(239,68,68,.2);border-radius:9px;padding:12px 15px;flex:1;min-width:110px;text-align:center;'>\n      <p style='color:#fca5a5;font-size:.85rem;margin:0;'><strong>人工智慧</strong><br><span style='font-size:.73rem;'>太大，講不完</span></p></div>\n    <span style='color:#f59e0b;'>&#8594;</span>\n    <div style='background:rgba(245,158,11,.2);border-radius:9px;padding:12px 15px;flex:1;min-width:110px;text-align:center;'>\n      <p style='color:#fcd34d;font-size:.85rem;margin:0;'><strong>AI 在醫療的應用</strong><br><span style='font-size:.73rem;'>好一點，還是太廣</span></p></div>\n    <span style='color:#f59e0b;'>&#8594;</span>\n    <div style='background:rgba(132,204,22,.2);border-radius:9px;padding:12px 15px;flex:1;min-width:110px;text-align:center;'>\n      <p style='color:#bef264;font-size:.85rem;margin:0;'><strong>AI 影像辨識<br>如何協助早期診斷</strong><br><span style='font-size:.73rem;'>快好了</span></p></div>\n    <span style='color:#f59e0b;'>&#8594;</span>\n    <div style='background:rgba(34,197,94,.25);border-radius:9px;padding:12px 15px;flex:1;min-width:110px;text-align:center;'>\n      <p style='color:#86efac;font-size:.85rem;margin:0;'><strong>AI 影像辨識在台灣醫療的應用與爭議</strong><br><span style='font-size:.73rem;'>✅ 有範圍、有場域、有角度</span></p></div>\n  </div>\n</div>\n<div style='background:#f0fdf4;border-radius:12px;padding:15px;margin-bottom:11px;'>\n  <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>🎯 好題目的三個條件</h3>\n  <div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#16a34a;font-size:.85rem;'>① 有範圍</strong>\n      <p style='font-size:.77rem;color:#475569;margin-top:4px;'>不是整個領域，是其中一塊</p></div>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#16a34a;font-size:.85rem;'>② 有場域</strong>\n      <p style='font-size:.77rem;color:#475569;margin-top:4px;'>在哪裡發生？台灣？學校？某個產業？</p></div>\n    <div style='background:#fff;border-radius:9px;padding:12px;'>\n      <strong style='color:#16a34a;font-size:.85rem;'>③ 有角度</strong>\n      <p style='font-size:.77rem;color:#475569;margin-top:4px;'>你想看它的什麼面向？應用？爭議？影響？</p></div>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🧪 <strong>檢查方法</strong>：把題目講給隔壁組聽，如果他們問「所以你到底要講什麼？」——那就還要再縮小一點。</p>\n</div>"}, {"id": 5, "chapter": "第一節：選題與提問", "title": "好問題與壞問題", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>❓ 定出你的「核心問題」</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;'>\n    <h3 style='color:#991b1b;font-size:.98rem;margin-bottom:8px;'>❌ 撐不起專題的問題</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>「什麼是物聯網？」<br><span style='color:#64748b;font-size:.77rem;'>→ 查一下就有答案</span></li>\n      <li>「AI 好不好？」<br><span style='color:#64748b;font-size:.77rem;'>→ 太籠統，無法回答</span></li>\n      <li>「未來會怎樣？」<br><span style='color:#64748b;font-size:.77rem;'>→ 沒有證據可以支持</span></li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>✅ 撐得起專題的問題</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>「智慧路燈真的能省電嗎？代價是什麼？」</li>\n      <li>「校園刷卡系統帶來的便利與隱私疑慮，該怎麼取捨？」</li>\n      <li>「生成式 AI 對國中生的學習，幫助多還是干擾多？」</li>\n      <li>「台灣的詐騙手法這幾年怎麼變？我們該怎麼防？」</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🔑 <strong>好問題的共同特徵</strong>：需要<strong>蒐集資料</strong>才能回答、有<strong>不同角度</strong>可以比較、你回答完之後<strong>別人會覺得有收穫</strong>。</p>\n</div>\n<div style='background:#f5f3ff;padding:11px 16px;border-radius:8px;border-left:4px solid #7c3aed;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💡 <strong>找題目的小技巧</strong>：從<strong>你自己真的好奇或困擾的事</strong>出發。「為什麼影片老是推薦我看過的類型？」「學校的冷氣為什麼要刷卡？」——這些都是很好的起點。</p>\n</div>"}, {"id": 6, "chapter": "第一節：選題與提問", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>選題與提問 ｜ 3 題</p>\n</div>"}, {"id": 7, "chapter": "第二節：找資料與查證", "title": "資料要從哪裡找", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📚 資料要從哪裡找？（由可信到不可信）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:20%;'>來源類型</th>\n    <th style='padding:7px;text-align:left;width:36%;'>具體例子</th>\n    <th style='padding:7px;text-align:left;'>怎麼用</th></tr>\n  <tr style='background:#f0fdf4;'><td style='padding:7px;'><strong style='color:#166534;'>★★★ 官方原始資料</strong></td><td style='padding:7px;'>政府資料開放平臺、各部會統計、臺北市政府資料大平臺</td><td style='padding:7px;'>當作數據主要依據，記得抄下年份</td></tr>\n  <tr style='background:#f0fdf4;'><td style='padding:7px;'><strong style='color:#166534;'>★★★ 研究機構報告</strong></td><td style='padding:7px;'>大學研究、法人研究機構、國際組織報告</td><td style='padding:7px;'>看它的統計方法與樣本說明</td></tr>\n  <tr style='background:#fefce8;'><td style='padding:7px;'><strong style='color:#854d0e;'>★★ 新聞報導</strong></td><td style='padding:7px;'>具名記者撰寫、有標明消息來源的報導</td><td style='padding:7px;'>用來找案例；數據要追回原始出處</td></tr>\n  <tr style='background:#fefce8;'><td style='padding:7px;'><strong style='color:#854d0e;'>★★ 百科與教材</strong></td><td style='padding:7px;'>維基百科、教科書、教學網站</td><td style='padding:7px;'>用來建立概念；<strong>看它文末的參考文獻</strong>再往下追</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'><strong style='color:#991b1b;'>✕ 避免使用</strong></td><td style='padding:7px;'>內容農場、無出處的懶人包、群組轉傳圖片</td><td style='padding:7px;'>不要當作依據</td></tr>\n</table>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🔍 <strong>搜尋技巧</strong>：在搜尋關鍵字後面加上「<code>filetype:pdf</code>」常能找到研究報告；加上「<code>site:gov.tw</code>」可以只搜尋政府網站。試試看「智慧路燈 節能 site:gov.tw」。</p>\n</div>"}, {"id": 8, "chapter": "第二節：找資料與查證", "title": "數據的三個必要條件", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔢 每一筆數據都要有三個條件</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>🏛️</div>\n    <strong style='color:#1e40af;font-size:.95rem;'>① 誰統計的</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>機構名稱。不同機構的定義可能不同，數字自然不同。</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>📅</div>\n    <strong style='color:#166534;font-size:.95rem;'>② 哪一年</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>科技領域的數字變化極快，五年前的數據可能已完全失效。</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>🔗</div>\n    <strong style='color:#854d0e;font-size:.95rem;'>③ 哪裡查得到</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>網址＋查閱日期，讓讀者（和老師）能自己驗證。</p></div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:11px;'>\n  <p style='color:#fbbf24;font-size:.9rem;font-weight:700;margin-bottom:7px;'>✏️ 對照一下</p>\n  <div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;'>\n    <div style='background:rgba(239,68,68,.18);border-radius:8px;padding:11px;'>\n      <p style='color:#fca5a5;font-size:.81rem;margin:0;'>❌ 「全世界有超過 200 億台 IoT 裝置」</p></div>\n    <div style='background:rgba(34,197,94,.18);border-radius:8px;padding:11px;'>\n      <p style='color:#86efac;font-size:.81rem;margin:0;'>✅ 「依 IoT Analytics 2025 年的估計，全球連網 IoT 裝置約 211 億台（來源網址，查閱日期 2026/○/○）」</p></div>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>⚠️ <strong>找不到出處的精確數字，就改用定性描述</strong>。與其寫「有 87.3% 的人認為…」卻查不到來源，不如寫「多數調查顯示…」並附上你找到的那份調查。</p>\n</div>"}, {"id": 9, "chapter": "第二節：找資料與查證", "title": "用 AI 幫忙的正確方式", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🤖 做專題時，AI 可以幫什麼、不能幫什麼</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>✅ 可以請 AI 做的</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>「幫我把這個題目拆成 4 個子問題」</li>\n      <li>「這個主題有哪些角度是我可能沒想到的？」</li>\n      <li>「幫我建議 5 個搜尋關鍵字」</li>\n      <li>「我這段話有沒有更清楚的寫法？」</li>\n      <li>「幫我出 3 個同學可能會問的問題」</li>\n    </ul>\n  </div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;'>\n    <h3 style='color:#991b1b;font-size:.98rem;margin-bottom:8px;'>❌ 不能直接採用的</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>AI 給的<strong>數據</strong>（可能是幻覺，必須查證）</li>\n      <li>AI 給的<strong>來源網址</strong>（很多打不開或不存在）</li>\n      <li>整段生成的內容直接貼進簡報</li>\n      <li>AI 對「哪個立場才對」的判斷</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:10px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    🔁 <strong style='color:#fbbf24;'>正確的工作流程</strong><br>\n    ① 用 AI 幫你<strong>想方向、找關鍵字</strong> → ② 拿關鍵字<strong>自己去查</strong>官方資料 → ③ 用<strong>自己的話</strong>整理 → ④ 標註<strong>真正查到的來源</strong> → ⑤ 附上 <strong>AI 使用聲明</strong></p>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎯 <strong>記住第 8–9 週學的</strong>：AI 是在「預測下一個詞」，不是在「查資料庫」。它給你的網址，很可能是它「覺得應該長這樣」的網址。<strong>一定要點開確認</strong>。</p>\n</div>"}, {"id": 10, "chapter": "第二節：找資料與查證", "title": "呈現不同立場", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>⚖️ 好的專題會呈現「不只一種聲音」</h2>\n<div style='background:#f5f3ff;border-radius:12px;padding:15px;margin-bottom:12px;'>\n  <p style='color:#5b21b6;font-size:.92rem;font-weight:700;margin-bottom:9px;'>為什麼要呈現不同立場？</p>\n  <p style='color:#334155;font-size:.84rem;margin:0;line-height:1.9;'>\n    因為真實世界的科技議題<strong>幾乎沒有一面倒的答案</strong>。只講好處，會被質疑「你有沒有查過反面意見？」；只講壞處，也一樣。<br>\n    能同時呈現兩面、並說出「我為什麼還是這樣想」——這是評分規準中 <strong>A 級</strong>的樣子。</p>\n</div>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:11px;'>\n  <p style='color:#fbbf24;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📐 一個好用的段落結構</p>\n  <div style='display:grid;grid-template-columns:repeat(4,1fr);gap:9px;'>\n    <div style='background:rgba(59,130,246,.18);border-radius:8px;padding:11px;text-align:center;'>\n      <p style='color:#93c5fd;font-size:.79rem;margin:0;'><strong>支持方</strong><br>他們的理由與證據</p></div>\n    <div style='background:rgba(239,68,68,.18);border-radius:8px;padding:11px;text-align:center;'>\n      <p style='color:#fca5a5;font-size:.79rem;margin:0;'><strong>反對方</strong><br>他們的擔憂與證據</p></div>\n    <div style='background:rgba(245,158,11,.18);border-radius:8px;padding:11px;text-align:center;'>\n      <p style='color:#fcd34d;font-size:.79rem;margin:0;'><strong>爭議點</strong><br>雙方真正的分歧在哪</p></div>\n    <div style='background:rgba(34,197,94,.18);border-radius:8px;padding:11px;text-align:center;'>\n      <p style='color:#86efac;font-size:.79rem;margin:0;'><strong>我們的看法</strong><br>並說明理由</p></div>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💡 <strong>誠實加分</strong>：如果你們組內意見不同，<strong>可以在報告中誠實寫出來</strong>——「我們組對這題有兩種看法」比硬湊出一個結論更有價值，也更真實。</p>\n</div>"}, {"id": 11, "chapter": "第二節：找資料與查證", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>找資料與查證 ｜ 3 題</p>\n</div>"}, {"id": 12, "chapter": "第三節：把內容變成簡報", "title": "專題簡報的標準結構", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📑 專題簡報的標準結構（6 頁以上）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:16%;'>頁次</th>\n    <th style='padding:7px;text-align:left;width:26%;'>內容</th>\n    <th style='padding:7px;text-align:left;'>要放什麼</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>第 1 頁</td><td style='padding:7px;'><strong>封面</strong></td><td style='padding:7px;'>題目、組員姓名與座號、班級、日期</td></tr>\n  <tr><td style='padding:7px;'>第 2 頁</td><td style='padding:7px;'><strong>為什麼選這題</strong></td><td style='padding:7px;'>你們的核心問題＋為什麼值得討論（可用一個生活小故事開場）</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>第 3 頁</td><td style='padding:7px;'><strong>它是什麼</strong></td><td style='padding:7px;'>用自己的話說明技術原理，配一張示意圖或流程圖</td></tr>\n  <tr><td style='padding:7px;'>第 4 頁</td><td style='padding:7px;'><strong>現況與案例</strong></td><td style='padding:7px;'>至少 1 個<strong>台灣在地案例</strong>＋數據（含來源年份）</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>第 5 頁</td><td style='padding:7px;'><strong>好處與疑慮</strong></td><td style='padding:7px;'>正反兩面，各至少兩點</td></tr>\n  <tr><td style='padding:7px;'>第 6 頁</td><td style='padding:7px;'><strong>我們的觀點</strong></td><td style='padding:7px;'>回答核心問題，並說出理由；可提出建議</td></tr>\n  <tr style='background:#fef3c7;'><td style='padding:7px;'>最後一頁</td><td style='padding:7px;'><strong>資料來源＋AI 聲明</strong></td><td style='padding:7px;'><strong>必要頁</strong>：所有引用來源清單、素材授權、AI 使用聲明</td></tr>\n</table>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎨 <strong>可以自由發揮</strong>：以上是骨架，不是限制。你們可以加頁、可以換順序，只要<strong>核心問題有被回答、來源有被標明</strong>就好。</p>\n</div>"}, {"id": 13, "chapter": "第三節：把內容變成簡報", "title": "一頁一重點", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎨 簡報設計：一頁一個重點</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-top:5px solid #dc2626;'>\n    <h3 style='color:#991b1b;font-size:.98rem;margin-bottom:8px;'>❌ 常見的失敗做法</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>整頁滿滿的字，上台照著念</li>\n      <li>字級太小，後排完全看不到</li>\n      <li>一頁塞了五個不相干的重點</li>\n      <li>背景花俏到看不清楚文字</li>\n      <li>用了七種顏色、五種字體</li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-top:5px solid #16a34a;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>✅ 有效的做法</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>一頁一個重點，標題就寫出結論</li>\n      <li>用<strong>關鍵字</strong>取代整句話</li>\n      <li>能用圖表或圖片說的，就別用文字</li>\n      <li>整份簡報只用 <strong>2–3 種顏色</strong></li>\n      <li>字級大到最後一排也看得清楚</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:10px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    🎯 <strong style='color:#fbbf24;'>關鍵觀念</strong>：簡報是<strong>你的輔助工具</strong>，不是你的講稿。<br>\n    觀眾的眼睛和耳朵不能同時處理兩份不同的內容——如果投影片上全是字，他們就會忙著讀字，沒在聽你講。</p>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🧪 <strong>自我檢查法</strong>：把簡報投影出來，退到教室最後一排看。看不清楚 → 字要放大。要讀超過 5 秒才懂 → 內容要精簡。</p>\n</div>"}, {"id": 14, "chapter": "第三節：把內容變成簡報", "title": "圖表選擇與誠實呈現", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📊 選對圖表，並且誠實呈現</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>📊</div>\n    <strong style='color:#1e40af;font-size:.93rem;'>長條圖</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'><strong>比較不同項目的多寡</strong><br>例：各行政區的公園數量</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>📈</div>\n    <strong style='color:#166534;font-size:.93rem;'>折線圖</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'><strong>看隨時間的變化趨勢</strong><br>例：近十年詐騙案件數</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>🥧</div>\n    <strong style='color:#854d0e;font-size:.93rem;'>圓餅圖</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'><strong>看各部分佔整體的比例</strong><br>項目最好不超過 6 個</p></div>\n</div>\n<div style='background:#fef2f2;border-radius:12px;padding:15px;margin-bottom:11px;border-left:5px solid #dc2626;'>\n  <h3 style='color:#991b1b;font-size:.98rem;margin-bottom:8px;'>⚠️ 圖表也會說謊——這三件事不要做</h3>\n  <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n    <li><strong>縱軸不從 0 開始</strong>：會讓 3% 的差距看起來像三倍</li>\n    <li><strong>只挑對自己有利的年份</strong>：截掉不利的資料段落</li>\n    <li><strong>沒有標題、沒有單位、沒有來源</strong>：讀者無從判斷</li>\n  </ul>\n</div>\n<div style='background:#f0fdf4;padding:11px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>✅ <strong>每張圖表都要有</strong>：標題、座標軸名稱與單位、資料來源與年份。做到這三點，你的圖表就比大部分的網路文章嚴謹了。</p>\n</div>"}, {"id": 15, "chapter": "第三節：把內容變成簡報", "title": "素材與版面", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🖼️ 素材與版面（第 5 週學的要用上）</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <h3 style='color:#1e40af;font-size:.98rem;margin-bottom:8px;'>📷 素材來源（安全度排序）</h3>\n    <ol style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:20px;margin:0;'>\n      <li><strong>自己拍、自己畫</strong>（最安全，也最有誠意）</li>\n      <li><strong>CC0 素材</strong>（Unsplash、Pixabay）</li>\n      <li><strong>創用 CC 素材</strong>（依授權條件標示）</li>\n      <li>依合理使用<strong>少量引用</strong>並註明出處</li>\n    </ol>\n    <p style='color:#dc2626;font-size:.79rem;margin-top:7px;'>❌ 搜尋引擎隨手抓圖直接用 → 影響「素材合法」20 分</p>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>🎨 版面小技巧</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>整份用<strong>同一套配色</strong>（主色＋輔色＋強調色）</li>\n      <li>字體最多用兩種，標題與內文各一</li>\n      <li><strong>留白很重要</strong>，不要塞滿整頁</li>\n      <li>對齊！文字框左邊對齊，畫面立刻變整齊</li>\n      <li>每頁角落標上<strong>負責人姓名</strong>（本次專題要求）</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#f5f3ff;padding:12px 16px;border-radius:8px;border-left:4px solid #7c3aed;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🤖 <strong>用 AI 生成圖片可以嗎？</strong>可以，但要在該頁或 AI 聲明中<strong>標明是 AI 生成</strong>，並附上你使用的提示詞。記得第 5 週學的：純 AI 生成的內容原則上不受著作權保護，而且<strong>不標示就是造假</strong>。</p>\n</div>"}, {"id": 16, "chapter": "第三節：把內容變成簡報", "title": "評分規準對照表", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:6px;'>📏 評分規準：做之前先看這一頁</h2>\n<p style='color:#ccfbf1;font-size:.85rem;margin-bottom:13px;'>拿 A 最快的方法，就是照著規準做</p>\n<div style='background:rgba(255,255,255,.95);border-radius:12px;padding:14px;margin-bottom:12px;'>\n  <table style='width:100%;border-collapse:collapse;font-size:.79rem;color:#334155;'>\n    <tr style='background:#0f766e;color:#fff;'>\n      <th style='padding:6px;text-align:left;width:22%;'>向度（配分）</th>\n      <th style='padding:6px;text-align:left;'>A 優秀</th>\n      <th style='padding:6px;text-align:left;'>B 良好</th>\n      <th style='padding:6px;text-align:left;'>C 基礎</th></tr>\n    <tr><td style='padding:6px;'><strong>內容完整（40）</strong></td>\n      <td style='padding:6px;'>定義、現況、應用、影響、觀點五項齊備且正確</td>\n      <td style='padding:6px;'>具備四項，大致正確</td>\n      <td style='padding:6px;'>具備三項，部分需修正</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:6px;'><strong>資料查證（20）</strong></td>\n      <td style='padding:6px;'>每筆數據都有來源＋年份，並比對兩個以上來源</td>\n      <td style='padding:6px;'>主要數據有標註來源</td>\n      <td style='padding:6px;'>部分資料有來源</td></tr>\n    <tr><td style='padding:6px;'><strong>版面與素材（20）</strong></td>\n      <td style='padding:6px;'>版面清楚，素材全為 CC／自製並註明出處</td>\n      <td style='padding:6px;'>素材大致合法並註明</td>\n      <td style='padding:6px;'>素材來源部分不明</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:6px;'><strong>口頭發表（20）</strong></td>\n      <td style='padding:6px;'>不看稿、時間掌控佳、能回答提問</td>\n      <td style='padding:6px;'>表達清楚、大致流暢</td>\n      <td style='padding:6px;'>照稿念讀但能講完</td></tr>\n  </table>\n</div>\n<div style='background:rgba(0,0,0,.22);border-radius:9px;padding:12px 18px;'>\n  <p style='color:#f0fdfa;font-size:.88rem;margin:0;'>💡 注意「資料查證」與「素材合法」加起來就有 <strong>40 分</strong>——這兩項不需要天分，只需要<strong>細心</strong>。把出處記好，就是穩穩的分數。</p>\n</div>"}, {"id": 17, "chapter": "第三節：把內容變成簡報", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>簡報製作 ｜ 3 題</p>\n</div>"}, {"id": 18, "chapter": "第四節：分工與時程", "title": "怎麼分工才公平", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🤝 怎麼分工才公平又有效？</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:14px;'>\n    <div style='font-size:1.4rem;'>🔍</div>\n    <strong style='color:#1e40af;font-size:.87rem;'>資料組長</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>負責找資料、查證、建立來源清單</p></div>\n  <div style='background:#f0fdf4;border-radius:11px;padding:14px;'>\n    <div style='font-size:1.4rem;'>🎨</div>\n    <strong style='color:#166534;font-size:.87rem;'>設計組長</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>負責版面、配色、圖表、素材授權</p></div>\n  <div style='background:#fefce8;border-radius:11px;padding:14px;'>\n    <div style='font-size:1.4rem;'>✍️</div>\n    <strong style='color:#854d0e;font-size:.87rem;'>內容組長</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>負責把資料寫成通順的文字與講稿</p></div>\n  <div style='background:#f5f3ff;border-radius:11px;padding:14px;'>\n    <div style='font-size:1.4rem;'>📋</div>\n    <strong style='color:#5b21b6;font-size:.87rem;'>統籌組長</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>負責時程、開會紀錄、最後檢查</p></div>\n</div>\n<div style='background:#fef3c7;border-radius:11px;padding:14px;margin-bottom:11px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>分工不等於切割</strong>：每個人負責一個角色，但<strong>所有人都要了解全部內容</strong>。因為發表時，同學可能問到不是你負責的那一頁——那時候「這不是我做的」是最扣分的回答。</p>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;'>\n  <div style='background:#f0fdf4;border-radius:11px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>✅ 讓合作順利的做法</strong>\n    <ul style='color:#475569;font-size:.79rem;line-height:1.8;padding-left:18px;margin:6px 0 0;'>\n      <li>每次上課花 3 分鐘確認「誰做到哪」</li>\n      <li>用 Google 簡報共編，進度看得見</li>\n      <li>每頁角落標負責人姓名</li>\n      <li>遇到卡關<strong>立刻說</strong>，不要拖到最後</li>\n    </ul></div>\n  <div style='background:#fef2f2;border-radius:11px;padding:13px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>🚩 出現這些訊號要求助</strong>\n    <ul style='color:#475569;font-size:.79rem;line-height:1.8;padding-left:18px;margin:6px 0 0;'>\n      <li>有人連續兩週沒有進度</li>\n      <li>組內對主題方向嚴重分歧</li>\n      <li>快到期限但只完成不到一半</li>\n      <li>找不到符合主題的可信資料</li>\n    </ul>\n    <p style='color:#dc2626;font-size:.78rem;margin-top:6px;'>→ <strong>直接找老師</strong>，不要自己硬撐</p></div>\n</div>"}, {"id": 19, "chapter": "第四節：分工與時程", "title": "三週時程表", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📅 三週時程表（每週一節，時間很緊）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:14%;'>時間</th>\n    <th style='padding:7px;text-align:left;width:32%;'>課堂上要完成</th>\n    <th style='padding:7px;text-align:left;'>課後要完成</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'><strong>第 10 週</strong></td>\n    <td style='padding:7px;'>分組、腦力激盪、決定主題與核心問題、填寫<strong>專題企劃表</strong></td>\n    <td style='padding:7px;'>各自蒐集 3 筆以上資料，貼進共用文件（含來源網址）</td></tr>\n  <tr><td style='padding:7px;'><strong>第 10–11 週間</strong></td>\n    <td style='padding:7px;'>—</td>\n    <td style='padding:7px;'>建立素材清單、確認每筆資料的授權與年份</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'><strong>第 11 週</strong></td>\n    <td style='padding:7px;'>把資料整理成簡報架構、製作圖表、完成 <strong>6 頁初稿</strong></td>\n    <td style='padding:7px;'>補齊缺漏的內容與圖片，寫好每頁的講稿要點</td></tr>\n  <tr><td style='padding:7px;'><strong>第 11–12 週間</strong></td>\n    <td style='padding:7px;'>—</td>\n    <td style='padding:7px;'>依老師回饋修改；補上資料來源頁與 AI 使用聲明</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'><strong>第 12 週</strong></td>\n    <td style='padding:7px;'>定稿、分配發表段落、<strong>組內試講一次並計時</strong></td>\n    <td style='padding:7px;'>各自練習自己負責的段落，準備回答提問</td></tr>\n</table>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⏰ <strong>最常見的失敗</strong>：前兩週覺得「還有時間」，第 12 週才開始做。結果沒時間修改、沒時間試講，上台時一片混亂。<br>\n    <strong>解法很簡單：把第 11 週的初稿當成死線。</strong></p>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💾 <strong>存檔提醒</strong>：全部用 Google 簡報共編，自動存檔、有版本紀錄。<strong>不要有人把檔案下載到自己電腦做</strong>，那會產生版本混亂，而且那台電腦壞掉就完了。</p>\n</div>"}, {"id": 20, "chapter": "第四節：分工與時程", "title": "交件前的檢查清單", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>✅ 交件前的最後檢查清單</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 封面有<strong>題目、全部組員姓名座號、班級、日期</strong></p></div>\n  <div style='background:#eff6ff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 核心問題在第 2 頁有<strong>清楚寫出來</strong></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 至少有 <strong>1 個台灣在地案例</strong></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 每筆數據都有<strong>來源＋年份</strong></p></div>\n  <div style='background:#fefce8;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 有呈現<strong>好處與疑慮兩面</strong></p></div>\n  <div style='background:#fefce8;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 最後有<strong>回答核心問題</strong>並說出理由</p></div>\n  <div style='background:#f5f3ff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 每張圖片都<strong>知道來源與授權</strong></p></div>\n  <div style='background:#f5f3ff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 每張圖表都有<strong>標題、單位、來源</strong></p></div>\n  <div style='background:#fef2f2;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 有<strong>資料來源清單頁</strong></p></div>\n  <div style='background:#fef2f2;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 有 <strong>AI 使用聲明</strong>（沒用也要寫「未使用」）</p></div>\n  <div style='background:#ecfeff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 每頁角落有<strong>負責人姓名</strong></p></div>\n  <div style='background:#ecfeff;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'>☐ 已<strong>試講並計時</strong>，控制在 5 分鐘內</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🖨️ <strong>建議</strong>：把這一頁截圖存到手機，交件前一項一項對過去。這 12 個勾勾，就是 A 和 B 的差距。</p>\n</div>"}, {"id": 21, "chapter": "第四節：分工與時程", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>分工與時程 ｜ 3 題</p>\n</div>"}, {"id": 22, "chapter": "專題任務書", "title": "專題企劃表", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📋 專題企劃表（第 10 週課堂完成）</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <table style='width:100%;border-collapse:collapse;font-size:.83rem;'>\n    <tr style='background:#1e40af;color:#fff;'>\n      <th style='padding:7px;text-align:left;width:26%;'>欄位</th>\n      <th style='padding:7px;text-align:left;'>填寫內容</th></tr>\n    <tr><td style='padding:7px;color:#334155;'><strong>組別與組員</strong></td><td style='padding:7px;color:#64748b;'>班級、座號、姓名</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:7px;color:#334155;'><strong>主題（暫定）</strong></td><td style='padding:7px;color:#64748b;'>要有範圍、場域、角度</td></tr>\n    <tr><td style='padding:7px;color:#334155;'><strong>核心問題</strong></td><td style='padding:7px;color:#64748b;'>一句話，而且是需要查資料才能回答的問題</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:7px;color:#334155;'><strong>為什麼想做這題</strong></td><td style='padding:7px;color:#64748b;'>50 字以內，可以從生活經驗出發</td></tr>\n    <tr><td style='padding:7px;color:#334155;'><strong>預計找哪些資料</strong></td><td style='padding:7px;color:#64748b;'>列出 3 個以上具體的查詢方向或機構名稱</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:7px;color:#334155;'><strong>台灣在地案例</strong></td><td style='padding:7px;color:#64748b;'>至少想出 1 個（可以之後再換）</td></tr>\n    <tr><td style='padding:7px;color:#334155;'><strong>分工</strong></td><td style='padding:7px;color:#64748b;'>資料／設計／內容／統籌，寫出各自負責人</td></tr>\n    <tr style='background:#f8fafc;'><td style='padding:7px;color:#334155;'><strong>我們最擔心的事</strong></td><td style='padding:7px;color:#64748b;'>誠實寫，老師才知道要幫你們什麼</td></tr>\n  </table>\n</div>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>📝 企劃表交出後，老師會給每組<strong>書面或口頭回饋</strong>。主題可以在第 11 週前調整，<strong>但第 11 週之後就不再換題</strong>——因為沒有時間了。</p>\n</div>"}, {"id": 23, "chapter": "專題任務書", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 10–12 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>好題目三條件</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>有範圍、有場域、有角度；核心問題要查資料才答得出來</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>數據三要素</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>誰統計的、哪一年、哪裡查得到；查不到出處就改用定性描述</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>簡報原則</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>一頁一重點；簡報是輔助不是講稿；圖表要有標題單位來源</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>時程與分工</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>第 11 週一定要有初稿；分工不等於切割，每個人都要懂全部</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>你們花三週查證與整理出來的東西，值得好好講給大家聽。</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下兩週：成果發表與學期總結</p>\n</div>"}]