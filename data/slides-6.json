[{"id": 1, "chapter": "封面", "title": "資訊安全：人是最大的漏洞", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🎣</div>\n  <h1 style='font-size:2.4rem;font-weight:900;color:#fff;margin-bottom:10px;'>資訊安全：人是最大的漏洞</h1>\n  <h2 style='font-size:1.2rem;font-weight:400;color:#93c5fd;margin-bottom:22px;'>Information Security — The Weakest Link Is You</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🕵️ 社交工程</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔑 密碼防護</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🦠 惡意軟體</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 6 週</p>\n</div>"}, {"id": 2, "chapter": "第一節：社交工程", "title": "你點了嗎？", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>「超好玩遊戲免費下載」— 你點了嗎？</h2>\n<div style='background:#1e293b;border-radius:12px;padding:20px;margin-bottom:12px;text-align:center;'>\n  <div style='background:linear-gradient(135deg,#dc2626,#f97316);border-radius:12px;padding:18px;display:inline-block;'>\n    <p style='color:#fff;font-size:1.15rem;font-weight:800;margin:0;'>🎮 限時免費！超好玩遊戲下載</p>\n    <p style='color:#fef3c7;font-size:.85rem;margin-top:6px;'>只剩 3 個名額，點我立即領取 →</p>\n  </div>\n  <p style='color:#94a3b8;font-size:.85rem;margin-top:14px;'>這就是<strong style='color:#fbbf24;'>社交工程攻擊（Social Engineering）</strong></p>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:13px 16px;margin-bottom:11px;border-left:4px solid #dc2626;'>\n  <p style='color:#0f172a;font-size:.9rem;margin:0;line-height:1.9;'>\n    📖 <strong>社交工程</strong>：不去攻擊電腦系統，而是<strong>攻擊「人」</strong>——利用信任、好奇、貪小便宜、恐慌或急迫感，誘使你自己交出帳密、點開連結或安裝程式。</p>\n</div>\n<div style='background:#fef3c7;padding:12px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>🧠 <strong>核心觀念</strong>：不論防火牆多強、加密多複雜，只要「人」的行為出現漏洞，攻擊者就能輕鬆突破。<strong>資安不是 IT 部門的事，是每個人的事。</strong></p>\n</div>"}, {"id": 3, "chapter": "第一節：社交工程", "title": "社交工程的三大手法", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🕵️ 社交工程的常見手法</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-top:5px solid #dc2626;'>\n    <div style='font-size:1.7rem;'>🎣</div>\n    <strong style='color:#991b1b;font-size:.95rem;'>釣魚信件／簡訊</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>偽裝成銀行、學校、物流、遊戲官方，寄出以假亂真的通知，誘你點連結輸入帳密。</p></div>\n  <div style='background:#fff7ed;border-radius:12px;padding:15px;border-top:5px solid #f97316;'>\n    <div style='font-size:1.7rem;'>📞</div>\n    <strong style='color:#9a3412;font-size:.95rem;'>假冒電話／客服</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>冒充客服、警察、公家機關，說你「訂單有問題」「涉及案件」，騙取個資或誘導操作 ATM。</p></div>\n  <div style='background:#f5f3ff;border-radius:12px;padding:15px;border-top:5px solid #7c3aed;'>\n    <div style='font-size:1.7rem;'>🎮</div>\n    <strong style='color:#5b21b6;font-size:.95rem;'>惡意軟體偽裝</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>偽裝成遊戲外掛、破解軟體、修圖 App，安裝後在背景竊取資料或鎖住檔案。</p></div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:10px;'>\n  <p style='color:#fbbf24;font-size:.9rem;font-weight:700;margin-bottom:6px;'>🎯 他們都在利用同樣的四種心理</p>\n  <div style='display:grid;grid-template-columns:repeat(4,1fr);gap:8px;'>\n    <div style='background:rgba(255,255,255,.08);border-radius:7px;padding:9px;text-align:center;'><p style='color:#e2e8f0;font-size:.79rem;margin:0;'><strong>好奇</strong><br>「你被標記了」</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:7px;padding:9px;text-align:center;'><p style='color:#e2e8f0;font-size:.79rem;margin:0;'><strong>貪</strong><br>「免費領取」</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:7px;padding:9px;text-align:center;'><p style='color:#e2e8f0;font-size:.79rem;margin:0;'><strong>怕</strong><br>「帳號將停用」</p></div>\n    <div style='background:rgba(255,255,255,.08);border-radius:7px;padding:9px;text-align:center;'><p style='color:#e2e8f0;font-size:.79rem;margin:0;'><strong>急</strong><br>「限時 1 小時」</p></div>\n  </div>\n</div>\n<div style='background:#f0fdf4;padding:11px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>✋ <strong>萬用解法：停三秒</strong>。當一則訊息讓你覺得「好興奮」或「好緊張」，那就是它<strong>正在操作你的情緒</strong>——這時候先停下來，換個管道查證。</p>\n</div>"}, {"id": 4, "chapter": "第一節：社交工程", "title": "學生最常遇到的陷阱", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🚨 國中生最常遇到的五種陷阱</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#991b1b;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:26%;'>常見話術</th>\n    <th style='padding:7px;text-align:left;width:32%;'>他真正想要的</th>\n    <th style='padding:7px;text-align:left;'>正確做法</th></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>「遊戲免費送寶物，加我好友」</td><td style='padding:7px;'>你的遊戲帳密／手機驗證碼</td><td style='padding:7px;'>官方活動只會在官網公告；不加陌生人、不給驗證碼</td></tr>\n  <tr><td style='padding:7px;'>「幫我代收簡訊驗證碼，給你 500 元」</td><td style='padding:7px;'>用你的門號註冊人頭帳號</td><td style='padding:7px;'>絕對拒絕。驗證碼＝你的身分，可能因此涉入犯罪</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>「我是你朋友，手機壞了跟你借錢」</td><td style='padding:7px;'>盜用帳號後向好友詐財</td><td style='padding:7px;'>打電話或當面確認，不要只靠訊息</td></tr>\n  <tr><td style='padding:7px;'>「傳一張自拍給我，我們是好朋友嘛」</td><td style='padding:7px;'>取得私密影像後勒索</td><td style='padding:7px;'>絕不傳送私密影像；已發生請立刻告訴大人</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>「破解版遊戲／免費 Vbucks 產生器」</td><td style='padding:7px;'>讓你安裝惡意軟體</td><td style='padding:7px;'>只從官方商店下載；「免費的最貴」</td></tr>\n</table>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🆘 <strong>如果已經上當了怎麼辦？</strong>① <strong>立刻告訴家長或老師</strong>，越早越好處理　② 馬上更改該帳號與相同密碼的其他帳號　③ 保留截圖作為證據　④ 必要時撥打<strong>165 反詐騙諮詢專線</strong>。<br>\n    <span style='color:#dc2626;font-weight:600;'>被騙不是你的錯，隱瞞才會讓事情變嚴重。</span></p>\n</div>"}, {"id": 5, "chapter": "第一節：社交工程", "title": "台灣的資安處境", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🇹🇼 台灣的資安處境</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;'>\n    <h3 style='color:#991b1b;font-size:.98rem;margin-bottom:8px;'>📊 我們面對的情況</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>多份國際資安報告指出，台灣是<strong>全球遭受網路攻擊最頻繁的地區之一</strong></li>\n      <li>攻擊目標涵蓋政府、醫院、學校、製造業與一般民眾</li>\n      <li>詐騙集團的話術與工具（含 AI 生成內容）不斷翻新</li>\n      <li>相當高比例的資安事件，起因都是<strong>「人的行為」</strong>而非技術漏洞</li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>🛡️ 你可以用的官方資源</h3>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li><strong>165 反詐騙諮詢專線</strong>：可疑訊息可先打去問</li>\n      <li><strong>教育部全民資安素養網</strong>：資安自我評量與教材</li>\n      <li><strong>iWIN 網路內容防護機構</strong>：檢舉不當網路內容</li>\n      <li><strong>臺北市科技教育網</strong>：網路使用習慣自我篩檢量表</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:12px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🔎 <strong>查證這件事本身就是練習</strong>：以上數據會逐年變化。做專題時請到<strong>官方網站查最新版本</strong>並註明年份——不要直接引用課堂投影片上的數字。</p>\n</div>"}, {"id": 6, "chapter": "第一節：社交工程", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>社交工程 ｜ 3 題</p>\n</div>"}, {"id": 7, "chapter": "第二節：辨識釣魚攻擊", "title": "釣魚信件五個破綻", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔍 釣魚信件的五個破綻</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#fef2f2;padding:13px;border-radius:10px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>① 寄件者網域怪怪的</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>看 @ 後面！<code>@bank.com.tw</code> 和 <code>@bank-service.xyz</code> 差很多。多一個字母、換一個字尾都是常見手法。</p></div>\n  <div style='background:#fff7ed;padding:13px;border-radius:10px;'>\n    <strong style='color:#9a3412;font-size:.88rem;'>② 逼你「立刻」處理</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「24 小時內未驗證將停用帳號」——製造恐慌，讓你來不及思考。</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.88rem;'>③ 稱呼很籠統</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「親愛的用戶您好」——真正的機構通常會叫得出你的名字或帳號末幾碼。</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#5b21b6;font-size:.88rem;'>④ 文字有翻譯腔或錯字</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>用詞不自然、簡繁體混用、標點怪異。不過 AI 讓這個破綻越來越少，不能只靠這一點。</p></div>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;grid-column:span 2;'>\n    <strong style='color:#1e40af;font-size:.88rem;'>⑤ 要你點連結或開附件輸入帳密</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'><strong>這是最關鍵的一點。</strong>正當機構<strong>不會</strong>用 Email 或簡訊要求你點連結輸入密碼、信用卡號或驗證碼。看到這種要求，直接當成詐騙處理。</p></div>\n</div>\n<div style='background:#f0fdf4;padding:11px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>✅ <strong>黃金守則</strong>：不點信裡的連結。要登入就<strong>自己打開瀏覽器輸入官網網址</strong>，或用官方 App。這一招可以擋掉絕大多數釣魚攻擊。</p>\n</div>"}, {"id": 8, "chapter": "第二節：辨識釣魚攻擊", "title": "看懂一個網址", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🌐 看懂一個網址：真正重要的是哪一段？</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <p style='color:#94a3b8;font-size:.82rem;margin-bottom:10px;'>網址的結構（由左往右讀，但<strong style='color:#fbbf24;'>要看的是「最後一個斜線之前、最右邊的兩三段」</strong>）</p>\n  <div style='background:#0f172a;border-radius:9px;padding:14px;font-family:monospace;font-size:.9rem;margin-bottom:12px;'>\n    <span style='color:#64748b;'>https://</span><span style='color:#64748b;'>login.</span><span style='color:#4ade80;font-weight:700;'>fhehs.tp.edu.tw</span><span style='color:#64748b;'>/account</span>\n    <p style='color:#4ade80;font-size:.75rem;margin-top:6px;font-family:sans-serif;'>✅ 真正的網域是 fhehs.tp.edu.tw</p>\n  </div>\n  <div style='background:#0f172a;border-radius:9px;padding:14px;font-family:monospace;font-size:.9rem;'>\n    <span style='color:#64748b;'>https://</span><span style='color:#64748b;'>fhehs.tp.edu.tw.</span><span style='color:#f87171;font-weight:700;'>secure-login.xyz</span><span style='color:#64748b;'>/verify</span>\n    <p style='color:#f87171;font-size:.75rem;margin-top:6px;font-family:sans-serif;'>❌ 真正的網域是 secure-login.xyz，前面那串只是騙你的幌子</p>\n  </div>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;'>\n  <div style='background:#eff6ff;border-radius:10px;padding:13px;'>\n    <strong style='color:#1e40af;font-size:.88rem;'>💻 電腦上怎麼看</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>滑鼠<strong>移到連結上不要點</strong>，瀏覽器左下角會顯示真實網址。</p></div>\n  <div style='background:#f0fdf4;border-radius:10px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>📱 手機上怎麼看</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'><strong>長按連結</strong>會跳出預覽，可以看到完整網址再決定。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;margin-top:11px;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>🔒 <strong>注意</strong>：有鎖頭（HTTPS）只代表「連線有加密」，<strong>不代表這個網站是好人</strong>。詐騙網站現在幾乎都有鎖頭。要看的是<strong>網域名稱</strong>。</p>\n</div>"}, {"id": 9, "chapter": "第二節：辨識釣魚攻擊", "title": "實戰演練：這封信有問題嗎", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧪 實戰演練：找出這封信的四個破綻</h2>\n<div style='background:#f8fafc;border:2px solid #cbd5e1;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <div style='border-bottom:1px solid #e2e8f0;padding-bottom:9px;margin-bottom:9px;'>\n    <p style='font-size:.82rem;color:#475569;margin:0;'><strong>寄件者：</strong>芳和實驗中學資訊組 &lt;fhehs-service@mail-verify.top&gt; <span style='background:#fee2e2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:.72rem;'>破綻 1</span></p>\n    <p style='font-size:.82rem;color:#475569;margin:4px 0 0;'><strong>主旨：</strong>【緊急】您的學校帳號將於 3 小時後停用 <span style='background:#fee2e2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:.72rem;'>破綻 2</span></p>\n  </div>\n  <p style='font-size:.85rem;color:#334155;line-height:1.9;margin:0;'>\n    親愛的用戶您好： <span style='background:#fee2e2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:.72rem;'>破綻 3</span><br><br>\n    系統偵測到您的帳號有異常登入紀錄。為保障您的權益，請於 3 小時內點擊下方連結，輸入您的<strong>學號與密碼</strong>完成身分驗證，逾期帳號將永久停用，所有雲端資料將被刪除。<br><br>\n    <span style='color:#2563eb;text-decoration:underline;'>👉 立即驗證我的帳號</span> <span style='background:#fee2e2;color:#991b1b;padding:1px 6px;border-radius:4px;font-size:.72rem;'>破綻 4</span><br><br>\n    芳和實驗中學 資訊安全中心 敬上</p>\n</div>\n<div style='background:#f0fdf4;padding:12px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.86rem;margin:0;line-height:1.9;'>\n    <strong>解答</strong>：① 寄件網域是 <code>mail-verify.top</code>，不是學校的 <code>fhehs.tp.edu.tw</code>　② 用「3 小時後停用」製造恐慌　③ 稱呼籠統，真正的學校信會有你的姓名或學號　④ <strong>要求點連結輸入密碼</strong>——學校絕不會這樣做。</p>\n</div>"}, {"id": 10, "chapter": "第二節：辨識釣魚攻擊", "title": "不只有 Email", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📲 釣魚不只有 Email：四種常見管道</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:14px;'>\n    <strong style='color:#1e40af;font-size:.9rem;'>📧 Email 釣魚（Phishing）</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>最傳統也最大量。偽裝成銀行、學校、購物平台、雲端服務。</p></div>\n  <div style='background:#f0fdf4;border-radius:11px;padding:14px;'>\n    <strong style='color:#166534;font-size:.9rem;'>💬 簡訊釣魚（Smishing）</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「您的包裹地址有誤，請點此更新」——短網址讓你看不出真實網域。</p></div>\n  <div style='background:#fefce8;border-radius:11px;padding:14px;'>\n    <strong style='color:#854d0e;font-size:.9rem;'>📞 語音釣魚（Vishing）</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>假冒客服或公務機關來電。現在還可能用 AI 模仿熟人的聲音。</p></div>\n  <div style='background:#f5f3ff;border-radius:11px;padding:14px;'>\n    <strong style='color:#5b21b6;font-size:.9rem;'>📷 QR Code 釣魚（Quishing）</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>在停車場、傳單、海報上貼假 QR Code，掃了就導到假的付款頁。</p></div>\n</div>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>QR Code 特別要小心</strong>：掃描前先看看那張貼紙是不是被<strong>後貼上去</strong>的（邊緣翹起、蓋住原本的圖案）。掃完之後，<strong>先看網址再決定要不要開</strong>。</p>\n</div>\n<div style='background:#f0fdf4;padding:11px 16px;border-radius:8px;border-left:4px solid #16a34a;margin-top:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>☎️ <strong>不管哪一種管道，做法都一樣</strong>：<strong>換一個你自己知道的管道去確認</strong>。收到「爸爸」的借錢訊息，就打電話給爸爸；收到「銀行」的通知，就打卡片背面的客服電話。</p>\n</div>"}, {"id": 11, "chapter": "第二節：辨識釣魚攻擊", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>辨識釣魚攻擊 ｜ 3 題</p>\n</div>"}, {"id": 12, "chapter": "第三節：密碼與帳號防護", "title": "密碼破解要多久", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔓 你的密碼撐得住嗎？</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <p style='color:#94a3b8;font-size:.82rem;margin-bottom:12px;'>電腦破解密碼的速度隨硬體進步而不斷變快，以下為<strong style='color:#fbbf24;'>相對難度示意</strong>（實際時間依攻擊方式與硬體而異）：</p>\n  <table style='width:100%;border-collapse:collapse;font-size:.85rem;'>\n    <tr style='background:rgba(239,68,68,.25);'><td style='padding:8px;color:#fca5a5;font-family:monospace;'>1234</td><td style='padding:8px;color:#fca5a5;'>瞬間 — 字典檔第一個就是它</td></tr>\n    <tr style='background:rgba(239,68,68,.18);'><td style='padding:8px;color:#fca5a5;font-family:monospace;'>password</td><td style='padding:8px;color:#fca5a5;'>瞬間 — 全球最常見密碼之一</td></tr>\n    <tr style='background:rgba(245,158,11,.2);'><td style='padding:8px;color:#fcd34d;font-family:monospace;'>abc123456</td><td style='padding:8px;color:#fcd34d;'>很快 — 純小寫加數字，組合太少</td></tr>\n    <tr style='background:rgba(132,204,22,.18);'><td style='padding:8px;color:#bef264;font-family:monospace;'>P@ssw0rd!</td><td style='padding:8px;color:#bef264;'>較久，但仍屬常見替換法（a→@、o→0）</td></tr>\n    <tr style='background:rgba(34,197,94,.2);'><td style='padding:8px;color:#86efac;font-family:monospace;'>Wo3Ai#ChiRouSong2025</td><td style='padding:8px;color:#86efac;'>非常久 — 夠長、夠雜、不在字典裡</td></tr>\n  </table>\n</div>\n<div style='background:#f0fdf4;padding:12px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;line-height:1.85;'>\n    🔑 <strong>好密碼三條件</strong>：① <strong>長度 12 字元以上</strong>（長度比複雜度更重要）　② <strong>大小寫＋數字＋符號</strong>混合　③ <strong>每個重要帳號用不同密碼</strong>。<br>\n    <span style='color:#64748b;font-size:.83rem;'>小技巧：把一句只有你知道的中文句子改寫成英數符號，例如「我最愛吃肉鬆」→ <code>Wo3Ai#ChiRouSong2025</code>。</span></p>\n</div>"}, {"id": 13, "chapter": "第三節：密碼與帳號防護", "title": "為什麼不能重複用密碼", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>♻️ 為什麼「所有網站都用同一組密碼」很危險？</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.93rem;font-weight:700;margin-bottom:10px;'>撞庫攻擊（Credential Stuffing）</p>\n  <div style='display:flex;align-items:center;gap:8px;flex-wrap:wrap;'>\n    <div style='background:rgba(239,68,68,.2);border-radius:9px;padding:11px 13px;flex:1;min-width:130px;'>\n      <p style='color:#fca5a5;font-size:.79rem;margin:0;'><strong>①</strong> 某個小網站被駭，帳密清單外洩</p></div>\n    <span style='color:#f59e0b;'>&#8594;</span>\n    <div style='background:rgba(245,158,11,.2);border-radius:9px;padding:11px 13px;flex:1;min-width:130px;'>\n      <p style='color:#fcd34d;font-size:.79rem;margin:0;'><strong>②</strong> 攻擊者拿這份清單，自動去試登入其他網站</p></div>\n    <span style='color:#f59e0b;'>&#8594;</span>\n    <div style='background:rgba(220,38,38,.25);border-radius:9px;padding:11px 13px;flex:1;min-width:130px;'>\n      <p style='color:#fca5a5;font-size:.79rem;margin:0;'><strong>③</strong> 你的 Email、社群、遊戲帳號如果用同一組，全部淪陷</p></div>\n  </div>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:11px;'>\n  <div style='background:#fef2f2;border-radius:10px;padding:13px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>🚨 Email 是最重要的帳號</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>因為<strong>所有網站的「忘記密碼」都寄到那裡</strong>。Email 被攻破 ≈ 全部帳號被攻破。它一定要用最強、最獨特的密碼＋雙因素驗證。</p></div>\n  <div style='background:#f0fdf4;border-radius:10px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>✅ 分級管理最實際</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>不用每個網站都不一樣。把帳號分成三級：<strong>重要</strong>（Email、學校、金融）各自獨立密碼；<strong>一般</strong>（社群、遊戲）；<strong>隨便註冊的</strong>可共用一組。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>📝 <strong>密碼放哪裡？</strong>不要寫在課本封面或手機備忘錄。可以用<strong>密碼管理員</strong>（瀏覽器內建的也算），或寫在紙上放家裡安全的地方——重點是<strong>不要放在別人看得到的地方</strong>。</p>\n</div>"}, {"id": 14, "chapter": "第三節：密碼與帳號防護", "title": "雙因素驗證", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔐 雙因素驗證（2FA）：最有效的一招</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:13px 16px;margin-bottom:12px;border-left:4px solid #0d9488;'>\n  <p style='color:#0f172a;font-size:.9rem;margin:0;'>📖 除了密碼之外，登入時<strong>再驗證第二種東西</strong>。即使密碼被偷，攻擊者也進不去。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>🧠</div>\n    <strong style='color:#1e40af;font-size:.9rem;'>你「知道」的</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>密碼、PIN 碼、圖形鎖</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>📱</div>\n    <strong style='color:#166534;font-size:.9rem;'>你「持有」的</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>手機驗證碼、驗證器 App、實體安全金鑰</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.6rem;'>👆</div>\n    <strong style='color:#854d0e;font-size:.9rem;'>你「本身」的</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>指紋、臉部辨識、虹膜</p></div>\n</div>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🚫 <strong>再說一次：驗證碼絕對不能給任何人。</strong>不管對方自稱是客服、警察、朋友還是「幫你處理帳號問題」的人。<strong>正當機構永遠不會跟你要驗證碼。</strong>把驗證碼給別人，等於把你的身分交出去。</p>\n</div>\n<div style='background:#f0fdf4;padding:11px 16px;border-radius:8px;border-left:4px solid #16a34a;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>✅ <strong>今天回家就做</strong>：打開你的 Google 帳號設定，找到「兩步驟驗證」並開啟。五分鐘的事，能擋掉絕大多數的帳號盜用。</p>\n</div>"}, {"id": 15, "chapter": "第三節：密碼與帳號防護", "title": "帳號健檢清單", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:6px;'>✅ 帳號健檢清單</h2>\n<p style='color:#ccfbf1;font-size:.85rem;margin-bottom:14px;'>對照下面每一項，勾勾看你做到了幾項（這也是今天的作業之一）</p>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px;'>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ Email 帳號的密碼是<strong>獨一無二</strong>的</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 重要帳號都開了<strong>雙因素驗證</strong></p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 密碼<strong>不含</strong>生日、姓名、電話</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 密碼長度<strong>至少 12 個字元</strong></p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 沒有把密碼<strong>告訴任何人</strong>（含最好的朋友）</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 手機有<strong>設定鎖屏密碼</strong>與生物辨識</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 公用電腦用完<strong>一定登出</strong></p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:9px;padding:12px;'>\n    <p style='color:#fff;font-size:.84rem;margin:0;'>☐ 知道帳號被盜時<strong>該找誰、怎麼處理</strong></p></div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:12px 18px;'>\n  <p style='color:#f0fdfa;font-size:.88rem;margin:0;'>🎯 <strong>作業提醒</strong>：學習單上<strong>不要填寫你的真實密碼</strong>，只要勾選有沒有做到、寫下你打算怎麼改進。</p>\n</div>"}, {"id": 16, "chapter": "第三節：密碼與帳號防護", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>密碼與帳號防護 ｜ 3 題</p>\n</div>"}, {"id": 17, "chapter": "第四節：惡意軟體與防護", "title": "常見惡意軟體", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🦠 常見的惡意軟體（Malware）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#991b1b;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:20%;'>類型</th>\n    <th style='padding:7px;text-align:left;width:36%;'>它做什麼</th>\n    <th style='padding:7px;text-align:left;'>常見感染途徑</th></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'><strong>勒索軟體</strong><br>Ransomware</td><td style='padding:7px;'>把你的檔案加密鎖住，要求付贖金</td><td style='padding:7px;'>釣魚信附件、破解軟體</td></tr>\n  <tr><td style='padding:7px;'><strong>木馬程式</strong><br>Trojan</td><td style='padding:7px;'>偽裝成正常軟體，安裝後在背景搞破壞</td><td style='padding:7px;'>非官方來源的 App、外掛</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'><strong>間諜軟體</strong><br>Spyware</td><td style='padding:7px;'>偷偷記錄你的鍵盤輸入、螢幕、位置</td><td style='padding:7px;'>惡意 App、瀏覽器擴充功能</td></tr>\n  <tr><td style='padding:7px;'><strong>廣告軟體</strong><br>Adware</td><td style='padding:7px;'>強制彈出廣告、竄改瀏覽器首頁</td><td style='padding:7px;'>免費軟體的「附贈安裝」</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'><strong>殭屍網路</strong><br>Botnet</td><td style='padding:7px;'>把你的裝置變成攻擊他人的工具</td><td style='padding:7px;'>沒改密碼的 IoT 裝置、未更新的系統</td></tr>\n</table>\n<div style='background:#fef3c7;padding:12px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    💡 <strong>幾乎所有感染都從同一件事開始</strong>：你<strong>自己</strong>下載並執行了某個東西。所以最有效的防護不是防毒軟體，而是——<strong>只從官方商店或官方網站下載</strong>。</p>\n</div>"}, {"id": 18, "chapter": "第四節：惡意軟體與防護", "title": "備份：對抗勒索的唯一解", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>💾 備份：對抗勒索軟體最有效的方法</h2>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.93rem;font-weight:700;margin-bottom:8px;'>為什麼「付贖金」不是好選項？</p>\n  <ul style='color:#e2e8f0;font-size:.84rem;line-height:1.9;padding-left:20px;margin:0;'>\n    <li>付了錢<strong>不保證</strong>對方會給你解密金鑰</li>\n    <li>你會被標記成「會付錢的目標」，可能再被攻擊一次</li>\n    <li>贖金會資助犯罪組織，讓下一個受害者出現</li>\n  </ul>\n  <p style='color:#4ade80;font-size:.88rem;font-weight:700;margin-top:10px;'>✅ 如果你有完整的備份，勒索軟體對你就沒有籌碼。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:11px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:14px;'>\n    <strong style='color:#1e40af;font-size:.89rem;'>📋 至少兩份</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>原檔＋備份，不要只有一份</p></div>\n  <div style='background:#f0fdf4;border-radius:11px;padding:14px;'>\n    <strong style='color:#166534;font-size:.89rem;'>📍 放在不同地方</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>一份在電腦、一份在雲端或外接硬碟</p></div>\n  <div style='background:#fefce8;border-radius:11px;padding:14px;'>\n    <strong style='color:#854d0e;font-size:.89rem;'>🔄 定期檢查</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>備份要真的能還原才算數，記得試一次</p></div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🎒 <strong>對你來說的實際做法</strong>：作業放<strong>學校雲端硬碟</strong>（自動備份＋版本紀錄），重要的專題檔案再另外存一份到隨身碟或個人雲端。期末交件前一天電腦壞掉，是每年都會發生的事。</p>\n</div>"}, {"id": 19, "chapter": "第四節：惡意軟體與防護", "title": "資安七個好習慣", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🛡️ 資安七個好習慣（把這頁存起來）</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>① 系統與 App 保持更新</strong><br><span style='font-size:.78rem;color:#64748b;'>更新的主要目的就是修補安全漏洞</span></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>② 只從官方商店下載</strong><br><span style='font-size:.78rem;color:#64748b;'>破解版、外掛、來路不明的連結一律不碰</span></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>③ 密碼夠長、不重複、開 2FA</strong><br><span style='font-size:.78rem;color:#64748b;'>Email 帳號要用最強的那一組</span></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>④ 不點來路不明的連結與附件</strong><br><span style='font-size:.78rem;color:#64748b;'>要登入就自己輸入官網網址</span></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>⑤ 公共 Wi-Fi 不做敏感的事</strong><br><span style='font-size:.78rem;color:#64748b;'>關掉「自動連線到開放網路」</span></p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:9px;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#166534;'>⑥ 重要檔案定期備份</strong><br><span style='font-size:.78rem;color:#64748b;'>至少兩份，放在不同地方</span></p></div>\n  <div style='background:#fffbeb;padding:12px;border-radius:9px;grid-column:span 2;'>\n    <p style='color:#334155;font-size:.84rem;margin:0;'><strong style='color:#92400e;'>⑦ 覺得怪怪的，就停下來問人</strong><br><span style='font-size:.78rem;color:#64748b;'>問老師、問家長、打 165。<strong>沒有人會因為你多問一句而笑你，但很多人因為不敢問而受害。</strong></span></p></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🏆 <strong>延伸活動</strong>：教育部有「<strong>全民資安素養自我評量</strong>」線上活動，可以測驗自己的資安知識。老師會公布連結，全班一起挑戰看看誰的分數最高。</p>\n</div>"}, {"id": 20, "chapter": "第四節：惡意軟體與防護", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>惡意軟體與防護 ｜ 3 題</p>\n</div>"}, {"id": 21, "chapter": "課堂實作", "title": "課堂實作：數位素養評量二刷", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎯 課堂實作：數位素養評量「二刷」＋帳號健檢（個人）</h2>\n<div style='background:#0f766e;border-radius:10px;padding:9px 16px;margin-bottom:10px;'>\n  <p style='color:#fff;font-size:.86rem;margin:0;'>🔗 <strong>https://isafeevent.moe.edu.tw/</strong>　｜　上週已經登入過了，這週直接<strong>換一部動畫挑戰</strong>　｜　活動到 <strong>11/15</strong> 截止</p>\n</div>\n<div style='display:grid;grid-template-columns:1.35fr 1fr;gap:11px;margin-bottom:10px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <h3 style='color:#1e40af;font-size:.97rem;margin-bottom:7px;'>📋 任務 A：換一部動畫，再挑戰一次</h3>\n    <ol style='color:#334155;font-size:.81rem;line-height:1.88;padding-left:20px;margin:0 0 9px;'>\n      <li>教育雲端帳號登入 →「開始評量」</li>\n      <li>挑一部<strong>和上週不同</strong>的 789 年級動畫：你們跟不跟？／不能重來的選擇／鏡頭下的隱形暴力</li>\n      <li>完整看完 → 作答 10 題 → <strong>截圖「抽獎次數」頁面</strong></li>\n      <li>比較看看：<strong>這次答對幾題？累積幾次抽獎機會了？</strong></li>\n    </ol>\n    <h3 style='color:#1e40af;font-size:.97rem;margin:0 0 6px;'>📋 任務 B：帳號健檢表</h3>\n    <p style='color:#334155;font-size:.81rem;line-height:1.85;margin:0;'>\n      對照第 15 頁的八項清單逐項勾選，寫下<strong>你打算改進的兩件事</strong>與<strong>什麼時候做</strong>。<br>\n      <strong style='color:#dc2626;'>⚠️ 不要在學習單上寫真實密碼。</strong></p>\n  </div>\n  <div style='background:#fffbeb;border-radius:12px;padding:15px;'>\n    <h3 style='color:#92400e;font-size:.97rem;margin-bottom:7px;'>📤 要繳交什麼</h3>\n    <ol style='color:#334155;font-size:.8rem;line-height:1.85;padding-left:20px;margin:0 0 9px;'>\n      <li><strong>「抽獎次數」頁面截圖</strong>（累積次數應該比上週多）</li>\n      <li>這次看的動畫名稱與答對題數</li>\n      <li><strong>帳號健檢表</strong>（兩件要改進的事＋時間）</li>\n      <li><strong>一句話</strong>：這兩週的評量題目裡，哪一題最像<strong>你身邊真的會發生的事</strong>？</li>\n    </ol>\n    <h3 style='color:#92400e;font-size:.97rem;margin:0 0 6px;'>📏 評分（規準二）</h3>\n    <table style='width:100%;font-size:.77rem;color:#334155;border-collapse:collapse;'>\n      <tr><td style='padding:4px 0;width:13%;'><strong style='color:#059669;'>A</strong></td><td>完成兩次評量與健檢，能連結題目情境說明自己的判斷依據與行動</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#2563eb;'>B</strong></td><td>完成評量與健檢，說明具體</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#d97706;'>C</strong></td><td>完成評量，健檢表部分完成</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#dc2626;'>D</strong></td><td>僅完成部分項目</td></tr>\n    </table>\n  </div>\n</div>\n<div style='background:#fef2f2;padding:10px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.85rem;margin:0;line-height:1.8;'>💬 <strong>老師想說的話</strong>：如果你曾經被騙過、或差點被騙，那不丟臉——連專業工程師都會中招。今天學的東西不是要你變得多疑，而是希望你在按下那個按鈕之前，<strong>多給自己三秒鐘</strong>。</p>\n</div>"}, {"id": 22, "chapter": "課堂實作", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 6 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>社交工程</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>攻擊「人」而非機器；利用好奇、貪、怕、急四種心理</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>釣魚辨識</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>看網域、看急迫感、看是否要你輸入密碼；<strong>不點信裡的連結</strong></p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>密碼與 2FA</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>12 字元以上、不重複、開雙因素；<strong>驗證碼絕不給人</strong></p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>惡意軟體與備份</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>只從官方來源下載；有備份，勒索軟體就沒籌碼</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>覺得怪怪的，就停下來問人。多問一句，不會有人笑你。</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：Deepfake 與科技倫理兩難</p>\n</div>"}]