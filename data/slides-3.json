[{"id": 1, "chapter": "封面", "title": "大數據與雲端運算", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>☁️</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>大數據與雲端運算</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Big Data &amp; Cloud Computing</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📊 4V</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔬 資料科學</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🗺️ Google 工具實作</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 3 週</p>\n</div>"}, {"id": 2, "chapter": "第一節：資料變成大數據", "title": "從資料到大數據", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>從「一筆資料」到「大數據」</h2>\n<div style='display:flex;align-items:stretch;gap:8px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>📝</div><strong style='color:#1e40af;font-size:.88rem;'>資料 Data</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「7A 班 32 人」<br>單獨的數字與文字</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.3rem;'>&#8594;</div>\n  <div style='background:#f0fdf4;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>📋</div><strong style='color:#166534;font-size:.88rem;'>資訊 Information</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「全校 7 年級共 320 人」<br>整理過、有意義</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.3rem;'>&#8594;</div>\n  <div style='background:#fefce8;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>💡</div><strong style='color:#854d0e;font-size:.88rem;'>知識 Knowledge</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「人數逐年下降，需調整班級數」<br>可以行動的洞見</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.3rem;'>&#8594;</div>\n  <div style='background:#f5f3ff;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>📊</div><strong style='color:#5b21b6;font-size:.88rem;'>大數據 Big Data</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>全國十年的資料<br>大到要用特殊工具處理</p></div>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:10px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.92rem;'>📖 <strong>大數據</strong>：資料量大到「傳統的試算表或單一台電腦」無法處理的資料集合，必須用分散式運算與專門的工具才分析得動。</p>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>💬 <strong>想一想</strong>：你今天用手機產生了哪些資料？（搜尋、按讚、位置、看影片的秒數…）這些資料最後去了哪裡、誰在用？</p>\n</div>"}, {"id": 3, "chapter": "第一節：資料變成大數據", "title": "大數據的 4V", "bg": "white", "quiz": null, "chart": null, "video": {"query": "什麼是大數據 Big Data 中文 介紹", "title": "延伸影片：什麼是大數據？", "desc": "在 YouTube 搜尋「大數據是什麼」，挑一支中文短片看看 4V"}, "html": "\n<h2 class='slide-title'>📊 大數據的四個特性（4V）</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>📦</div>\n    <strong style='font-size:1rem;'>Volume 大量</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料量龐大到單機處理不來。一部 4K 電影約幾十 GB，全球每天上傳的影片加起來是天文數字。</p></div>\n  <div style='background:linear-gradient(135deg,#065f46,#0d9488);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>⚡</div>\n    <strong style='font-size:1rem;'>Velocity 快速</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料即時產生、也要即時分析。地震速報要在幾秒內判斷並發警報，慢一秒就沒用了。</p></div>\n  <div style='background:linear-gradient(135deg,#9a3412,#f97316);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>🎨</div>\n    <strong style='font-size:1rem;'>Variety 多樣</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>文字、圖片、影片、聲音、感測器讀值、GPS 座標……格式全都不一樣，要先整理成能一起分析的形式。</p></div>\n  <div style='background:linear-gradient(135deg,#6b21a8,#a855f7);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>✅</div>\n    <strong style='font-size:1rem;'>Veracity 真實性</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料準不準確？感測器有沒有故障？問卷有沒有亂填？錯的資料會導出錯的決策。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🧠 <strong>記憶口訣</strong>：<strong>又多、又快、又雜、還不一定對</strong>——這就是大數據難搞的地方，也是它需要專門技術的原因。</p>\n</div>\n<div id='video-section-3' class='video-section'></div>"}, {"id": 4, "chapter": "第一節：資料變成大數據", "title": "大數據就在你身邊", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🇹🇼 大數據就在你身邊 — 台灣在地案例</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;border-left:5px solid #2563eb;'>\n    <strong style='color:#1e40af;font-size:.95rem;'>🏥 全民健保資料</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>台灣全民健保累積了長期、涵蓋幾乎全體國民的就醫紀錄，是國際上少見的大型健康資料庫，常被用於公共衛生與醫療研究（研究使用須經去識別化與審查）。</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-left:5px solid #16a34a;'>\n    <strong style='color:#166534;font-size:.95rem;'>🚲 YouBike 使用紀錄</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>每一次借還車都是一筆資料。分析後可以知道哪些站點早上永遠沒車、哪些站點晚上永遠停滿，據以調度車輛、決定新站點要設在哪。</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;border-left:5px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:.95rem;'>🚌 公車與捷運刷卡資料</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>電子票證讓每一次進出站都有紀錄，可以看出通勤尖峰、轉乘熱點，用來調整班次與規劃新路線。</p></div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-left:5px solid #dc2626;'>\n    <strong style='color:#991b1b;font-size:.95rem;'>🌏 政府開放資料平臺</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>空氣品質、雨量、停車位、實價登錄、農產品價格……政府把資料免費開放，任何人（包含你）都可以下載來做分析與應用。</p></div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🔗 想找資料做專題？搜尋「<strong>政府資料開放平臺</strong>」或「<strong>臺北市政府資料大平臺</strong>」，裡面有上萬筆免費、可合法使用的資料集。</p>\n</div>"}, {"id": 5, "chapter": "第一節：資料變成大數據", "title": "大數據的兩難", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>⚖️ 大數據的兩難：便利與監控只有一線之隔</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>👍 大數據幫我們做到</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>疫情期間追蹤疫調、預測物資需求</li>\n      <li>從交通資料改善壅塞與事故熱點</li>\n      <li>從醫療資料發現疾病的早期徵兆</li>\n      <li>推薦你可能真的會喜歡的內容</li>\n    </ul>\n  </div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;'>\n    <h3 style='color:#991b1b;font-size:1rem;margin-bottom:8px;'>👎 但同時也可能</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>把你的行蹤、喜好拼湊成完整檔案</li>\n      <li>用「精準投放」影響你的想法與選擇</li>\n      <li>把你關進只看得到同類意見的同溫層</li>\n      <li>資料一旦外洩，影響長久且難以挽回</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:10px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    🔐 <strong style='color:#fbbf24;'>關鍵概念：去識別化</strong><br>\n    研究使用大量個人資料時，必須先把姓名、身分證字號等可直接辨識個人的欄位移除或加密處理，讓資料無法對應回特定的人。這是《個人資料保護法》要求的基本保護——第 6 週會再深入。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💬 <strong>討論</strong>：如果政府要用手機定位資料來做防疫追蹤，你贊成嗎？需要加上哪些條件（例如期限、監督、事後刪除）你才會接受？</p>\n</div>"}, {"id": 6, "chapter": "第一節：資料變成大數據", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>大數據與 4V ｜ 3 題</p>\n</div>"}, {"id": 7, "chapter": "第二節：資料科學四步驟", "title": "資料科學四步驟", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔬 資料科學：從資料中挖出有用的知識</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:14px;'>\n    <div style='background:#2563eb;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>1</div>\n    <strong style='color:#1e40af;font-size:.88rem;'>收集資料</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>感測器、問卷、交易紀錄、開放資料</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:14px;'>\n    <div style='background:#16a34a;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>2</div>\n    <strong style='color:#166534;font-size:.88rem;'>資料清理</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>去除重複、錯誤、缺漏，統一格式</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:14px;'>\n    <div style='background:#eab308;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>3</div>\n    <strong style='color:#854d0e;font-size:.88rem;'>找出模式</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>用統計與演算法找出規律與關聯</p></div>\n  <div style='background:#f5f3ff;border-radius:12px;padding:14px;'>\n    <div style='background:#7c3aed;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>4</div>\n    <strong style='color:#5b21b6;font-size:.88rem;'>預測與決策</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>建立模型，根據歷史推測未來</p></div>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:13px 16px;margin-bottom:10px;'>\n  <p style='color:#334155;font-size:.87rem;margin:0;line-height:1.9;'>\n    🎬 <strong>用「串流平台怎麼知道你喜歡看什麼」走一遍</strong>：<br>\n    ① 記錄你看了哪些片、看多久、有沒有跳過 → ② 排除誤點開、家人共用等雜訊 → ③ 找出「看過 A 的人也常看 B」的規律 → ④ 推薦下一部給你</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>⏱️ <strong>冷知識</strong>：資料科學家常說，一個專案有<strong>大半時間花在第 2 步「清理」</strong>上。真實世界的資料，遠比課本上的漂亮表格髒得多。</p>\n</div>"}, {"id": 8, "chapter": "第二節：資料科學四步驟", "title": "髒資料長什麼樣", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧹 髒資料長什麼樣？（真實案例）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:22%;'>問題</th>\n    <th style='padding:7px;text-align:left;width:34%;'>例子</th>\n    <th style='padding:7px;text-align:left;'>怎麼處理</th></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>重複資料</td><td style='padding:7px;'>同一個人填了 3 次問卷</td><td style='padding:7px;'>依帳號或時間戳記去重複</td></tr>\n  <tr><td style='padding:7px;'>格式不一致</td><td style='padding:7px;'>「台北市」「臺北市」「北市」</td><td style='padding:7px;'>統一寫法（尋找與取代）</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>明顯錯誤值</td><td style='padding:7px;'>身高填 300、年齡填 999</td><td style='padding:7px;'>設定合理範圍，標記或排除</td></tr>\n  <tr><td style='padding:7px;'>缺漏值</td><td style='padding:7px;'>某幾天的溫度是空白</td><td style='padding:7px;'>標記為「無資料」，不要當成 0</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>單位混用</td><td style='padding:7px;'>有人填公分、有人填公尺</td><td style='padding:7px;'>換算成同一單位</td></tr>\n</table>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>「缺漏 ≠ 0」是最常見的致命錯誤</strong>：如果溫度沒測到卻填 0，算出來的平均氣溫會嚴重偏低。缺漏就標「無資料」，並在報告中說明有幾筆缺漏、你怎麼處理。</p>\n</div>"}, {"id": 9, "chapter": "第二節：資料科學四步驟", "title": "相關不等於因果", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🚨 資料素養最重要的一課：相關 ≠ 因果</h2>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.95rem;font-weight:700;margin-bottom:10px;'>「夏天冰淇淋賣得多，溺水事件也變多」→ 所以吃冰淇淋會溺水？</p>\n  <div style='display:flex;align-items:center;gap:10px;flex-wrap:wrap;'>\n    <div style='background:rgba(59,130,246,.2);border-radius:9px;padding:11px 15px;'>\n      <span style='color:#93c5fd;font-size:.85rem;'>🍦 冰淇淋銷量</span></div>\n    <span style='color:#64748b;'>&#8596;</span>\n    <div style='background:rgba(239,68,68,.2);border-radius:9px;padding:11px 15px;'>\n      <span style='color:#fca5a5;font-size:.85rem;'>🌊 溺水事件</span></div>\n    <span style='color:#64748b;margin-left:8px;'>兩者都被 →</span>\n    <div style='background:rgba(245,158,11,.25);border-radius:9px;padding:11px 15px;'>\n      <span style='color:#fbbf24;font-size:.85rem;font-weight:700;'>☀️ 天氣熱（真正的原因）</span></div>\n  </div>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:12px;'>兩件事一起發生（相關），不代表其中一件造成另一件（因果）。可能有第三個因素同時影響了兩者。</p>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;'>\n  <div style='background:#f0fdf4;border-radius:10px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>✅ 正確的說法</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「資料顯示這兩者<strong>有相關</strong>，可能的原因包括…，還需要進一步驗證。」</p></div>\n  <div style='background:#fef2f2;border-radius:10px;padding:13px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>❌ 危險的說法</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「資料<strong>證明</strong>了 A <strong>導致</strong> B。」——專題報告寫這句，會被扣分。</p></div>\n</div>"}, {"id": 10, "chapter": "第二節：資料科學四步驟", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>資料科學與資料素養 ｜ 3 題</p>\n</div>"}, {"id": 11, "chapter": "第三節：雲端運算", "title": "什麼是雲端運算", "bg": "white", "quiz": null, "chart": null, "video": {"query": "雲端運算 是什麼 三分鐘 中文", "title": "延伸影片：三分鐘認識雲端運算", "desc": "在 YouTube 搜尋「雲端運算 是什麼」，看看資料中心長什麼樣"}, "html": "\n<h2 class='slide-title'>☁️ 雲端運算：把運算與儲存搬到網路上</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:12px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.92rem;'>📖 透過<strong>網際網路</strong>提供的運算服務（伺服器、儲存空間、軟體），<strong>用多少付多少</strong>，不必自己買設備。</p>\n</div>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.92rem;font-weight:700;margin-bottom:8px;'>💡 破解迷思：「雲端」其實一點也不在天上</p>\n  <p style='color:#e2e8f0;font-size:.84rem;margin:0;line-height:1.9;'>\n    你的照片、作業並不是飄在雲裡，而是存在<strong>某個國家、某座資料中心、某台實體伺服器的硬碟</strong>上。「雲」只是一個比喻：你不需要知道它在哪，需要時打開網路就拿得到。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.87rem;'>💰 省成本</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>不用買伺服器、不用養機房，需求變大再加租</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.87rem;'>🔄 隨處存取</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>手機、平板、電腦登入同一帳號就能接續工作</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.87rem;'>💾 自動備份</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>有版本紀錄，改壞了可以還原成昨天的版本</p></div>\n</div>\n<div id='video-section-11' class='video-section'></div>"}, {"id": 12, "chapter": "第三節：雲端運算", "title": "你每天都在用的雲端", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📱 你每天都在用的雲端服務</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:26%;'>你在做的事</th>\n    <th style='padding:7px;text-align:left;'>背後的雲端運算</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📧 收發 Gmail</td><td style='padding:7px;'>信件存在 Google 的伺服器，換裝置登入都看得到</td></tr>\n  <tr><td style='padding:7px;'>📄 用 Google 文件寫作業</td><td style='padding:7px;'>不用按存檔，每次修改都即時同步到雲端並留下版本</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📸 手機照片自動備份</td><td style='padding:7px;'>手機掉了照片還在；也代表照片副本存在別人的機房</td></tr>\n  <tr><td style='padding:7px;'>🎮 雲端遊戲、線上遊戲存檔</td><td style='padding:7px;'>運算在遠端伺服器完成，你的裝置只負責顯示與操作</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>🤖 和 AI 聊天</td><td style='padding:7px;'>模型跑在資料中心的大量 GPU 上，不是在你的手機裡</td></tr>\n</table>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>雲端的另一面</strong>：<br>\n    ① <strong>沒網路就用不了</strong>（離線功能有限）　② <strong>資料存在別人的機房</strong>，要看清楚服務條款　③ <strong>分享權限設錯就等於公開</strong>　④ 服務可能終止或改變收費</p>\n</div>"}, {"id": 13, "chapter": "第三節：雲端運算", "title": "雲端分享權限", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔑 分享權限：外洩最常見的原因是「自己設錯」</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-top:5px solid #16a34a;'>\n    <strong style='color:#166534;font-size:.92rem;'>🔒 限制存取</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>只有你和你指定的人看得到。<br><strong>最安全</strong>，繳交作業時把老師加進來即可。</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;border-top:5px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:.92rem;'>🏫 校內知道連結者</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>限學校帳號才打得開。<br><strong>小組共編適用</strong>，記得選「檢視」或「編輯」要正確。</p></div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-top:5px solid #dc2626;'>\n    <strong style='color:#991b1b;font-size:.92rem;'>🌐 網路上任何人</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>全世界都能開。<br><strong>只用在真的要公開的東西</strong>，且絕不能給「編輯」權限。</p></div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ✅ <strong>三個好習慣</strong>：① 分享前先問「這份東西需要誰看得到？」② 給「檢視」就不要給「編輯」　③ 專題做完後回頭把不需要的分享權限收回來。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🧪 <strong>課堂小測試</strong>：把你的作業連結貼給隔壁組，看看他們打不打得開、能不能改。打得開就代表——全世界也打得開。</p>\n</div>"}, {"id": 14, "chapter": "第三節：雲端運算", "title": "雲端與大數據的關係", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>🔗 把三週的內容串起來</h2>\n<div style='background:rgba(255,255,255,.12);border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <div style='display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;'>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>📡</div><strong style='color:#fff;font-size:.86rem;'>IoT 感測器</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>持續產生資料</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>☁️</div><strong style='color:#fff;font-size:.86rem;'>雲端儲存</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>資料集中存放</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>📊</div><strong style='color:#fff;font-size:.86rem;'>大數據分析</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>找出規律</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>🤖</div><strong style='color:#fff;font-size:.86rem;'>AI 學習</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>下週的主題</p></div>\n  </div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:13px 18px;'>\n  <p style='color:#f0fdfa;font-size:.9rem;margin:0;line-height:1.9;'>\n    🧠 <strong>為什麼 AI 這幾年突然變強？</strong>因為這三件事同時到位了：<strong>IoT 與網路產生了海量資料</strong>、<strong>雲端提供了便宜的儲存與運算</strong>、<strong>晶片（GPU／NPU）跑得夠快</strong>。<br>\n    沒有資料，再厲害的 AI 也學不會東西——這就是下一週的起點。</p>\n</div>"}, {"id": 15, "chapter": "第三節：雲端運算", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>雲端運算與分享權限 ｜ 3 題</p>\n</div>"}, {"id": 16, "chapter": "第四節：Google 工具組實作", "title": "Google 工具組總覽", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧰 Google 工具組：雲端運算的最佳範例</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>📈</div><strong style='color:#1e40af;font-size:.88rem;'>試算表 Sheets</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>整理資料、算平均、畫圖表。今天的主角。</p></div>\n  <div style='background:#f0fdf4;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>🗺️</div><strong style='color:#166534;font-size:.88rem;'>My Maps</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>把資料放到地圖上，配合探索課程做地方踏查。</p></div>\n  <div style='background:#fefce8;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>📋</div><strong style='color:#854d0e;font-size:.88rem;'>表單 Forms</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>做問卷收資料，答案自動變成試算表。</p></div>\n  <div style='background:#f5f3ff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>📊</div><strong style='color:#5b21b6;font-size:.88rem;'>簡報 Slides</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>多人同時編輯同一份，第 10–14 週專題必用。</p></div>\n  <div style='background:#ecfeff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>📄</div><strong style='color:#155e75;font-size:.88rem;'>文件 Docs</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>寫學習單與企劃，可留言互評。</p></div>\n  <div style='background:#fef2f2;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.5rem;'>📁</div><strong style='color:#991b1b;font-size:.88rem;'>雲端硬碟 Drive</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.7;'>所有檔案的家，建立資料夾管理整學期作業。</p></div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>📂 <strong>先做這件事</strong>：在雲端硬碟建立資料夾 <code>115-1 資訊科技</code>，這學期所有作業都放進去。期末整理學習歷程時，你會感謝現在的自己。</p>\n</div>"}, {"id": 17, "chapter": "第四節：Google 工具組實作", "title": "Google 試算表入門", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📈 Google 試算表：四個函式打天下</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.84rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:24%;'>函式</th>\n    <th style='padding:7px;text-align:left;width:26%;'>做什麼</th>\n    <th style='padding:7px;text-align:left;'>寫法範例</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'><strong>SUM</strong></td><td style='padding:7px;'>加總</td><td style='padding:7px;'><code>=SUM(B2:B21)</code> → B2 到 B21 全部加起來</td></tr>\n  <tr><td style='padding:7px;'><strong>AVERAGE</strong></td><td style='padding:7px;'>平均</td><td style='padding:7px;'><code>=AVERAGE(B2:B21)</code> → 這 20 筆的平均值</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'><strong>MAX / MIN</strong></td><td style='padding:7px;'>最大／最小</td><td style='padding:7px;'><code>=MAX(B2:B21)</code>、<code>=MIN(B2:B21)</code></td></tr>\n  <tr><td style='padding:7px;'><strong>COUNT</strong></td><td style='padding:7px;'>有幾筆數字</td><td style='padding:7px;'><code>=COUNT(B2:B21)</code> → 空白的不算</td></tr>\n</table>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:10px;'>\n  <div style='background:#f0fdf4;border-radius:10px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>📊 插入圖表三步驟</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.8;'>① 選取要畫的資料範圍<br>② 功能表「插入 → 圖表」<br>③ 在右側選圖表類型、改標題</p></div>\n  <div style='background:#fffbeb;border-radius:10px;padding:13px;'>\n    <strong style='color:#92400e;font-size:.88rem;'>🎯 選對圖表類型</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.8;'><strong>長條圖</strong>：比較不同項目的多寡<br><strong>折線圖</strong>：看隨時間的變化<br><strong>圓餅圖</strong>：看各部分佔整體的比例（項目別超過 6 個）</p></div>\n</div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>⚠️ <strong>圖表也會說謊</strong>：如果長條圖的縱軸不從 0 開始，小差距看起來會像天壤之別。做圖表時<strong>一定要加標題、標明單位</strong>，看圖表時<strong>一定要先看縱軸</strong>。</p>\n</div>"}, {"id": 18, "chapter": "第四節：Google 工具組實作", "title": "Google My Maps 實作", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🗺️ Google My Maps：把資料放到地圖上說故事</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <h3 style='color:#1e40af;font-size:.98rem;margin-bottom:8px;'>🧭 操作五步驟</h3>\n    <ol style='color:#334155;font-size:.82rem;line-height:1.95;padding-left:20px;margin:0;'>\n      <li>用學校帳號登入，開啟 Google My Maps，「建立新地圖」</li>\n      <li>幫地圖命名（例如：<code>芳和周邊生活地圖</code>）</li>\n      <li>搜尋地點 →「新增至地圖」，建立標記</li>\n      <li>點標記可以編輯<strong>名稱、說明、加照片</strong>，也能改圖示顏色</li>\n      <li>用「圖層」分類（例如：美食／文化／綠地），再分享或嵌入</li>\n    </ol>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>🎒 配合七年級探索課程</h3>\n    <p style='font-size:.82rem;color:#475569;line-height:1.9;margin:0;'>\n      這學期七年級的探索課程會走出校園。你可以用 My Maps：<br>\n      • 標出踏查路線與觀察點<br>\n      • 每個點放一張<strong>自己拍的照片</strong>與 50 字觀察<br>\n      • 加入你查到的資料（例如該路口的車流、店家數量）<br>\n      • 期末把它變成統整成果的一部分</p>\n  </div>\n</div>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🧠 <strong>為什麼地圖這麼好用？</strong>因為人腦對「空間」的理解遠快於一堆數字。同樣一份資料，做成表格要看半天，放到地圖上，「哪裡多、哪裡少」一眼就看出來——這叫做<strong>資料視覺化</strong>。</p>\n</div>"}, {"id": 19, "chapter": "第四節：Google 工具組實作", "title": "安全使用雲端小提醒", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🛡️ 用 Google 工具的六個好習慣</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.87rem;'>① 檔名寫清楚</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'><code>座號_姓名_作業名稱</code>。老師收到 30 份「未命名文件」時會很想哭。</p></div>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.87rem;'>② 用資料夾分類</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>一科一個資料夾，期末找檔案不用翻半小時。</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.87rem;'>③ 善用版本紀錄</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>「檔案 → 版本記錄」可以看到誰改了什麼、還原到之前的版本。</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#5b21b6;font-size:.87rem;'>④ 共編要留名</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>小組作業在每頁註明負責人，貢獻度看得見，評分才公平。</p></div>\n  <div style='background:#fef2f2;padding:13px;border-radius:10px;'>\n    <strong style='color:#991b1b;font-size:.87rem;'>⑤ 不放敏感資料</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>身分證字號、住家地址、密碼，都不要放進共用文件。</p></div>\n  <div style='background:#ecfeff;padding:13px;border-radius:10px;'>\n    <strong style='color:#155e75;font-size:.87rem;'>⑥ 用完登出</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>公用電腦不登出，等於把整個雲端硬碟交給下一個人。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💡 這六點看起來很基本，但幾乎每一屆都有人在期末因為「檔案找不到」「權限沒開」而交不出作業。現在花五分鐘養成習慣，之後省下好幾小時。</p>\n</div>"}, {"id": 20, "chapter": "第四節：Google 工具組實作", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>Google 工具實作 ｜ 3 題</p>\n</div>"}, {"id": 21, "chapter": "課堂實作", "title": "課堂實作：我的生活資料地圖", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎯 課堂實作：我的生活資料地圖</h2>\n<div style='display:grid;grid-template-columns:1.25fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;'>\n    <h3 style='color:#1e40af;font-size:1rem;margin-bottom:8px;'>📋 任務（兩件事，個人或兩人一組）</h3>\n    <p style='font-size:.84rem;color:#334155;margin:0 0 6px;'><strong>A. Google My Maps</strong></p>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.85;padding-left:20px;margin:0 0 10px;'>\n      <li>建立一張地圖，標出<strong>「我的上學路線」上的 5 個地點</strong></li>\n      <li>每個標記寫上名稱＋一句觀察（例如「這個路口早上很塞」）</li>\n    </ul>\n    <p style='font-size:.84rem;color:#334155;margin:0 0 6px;'><strong>B. Google 試算表</strong></p>\n    <ul style='color:#334155;font-size:.82rem;line-height:1.85;padding-left:20px;margin:0;'>\n      <li>記錄<strong>連續 7 天</strong>的一項生活數據（睡眠時數／使用 3C 時數／步數擇一）</li>\n      <li>用 <code>AVERAGE</code>、<code>MAX</code>、<code>MIN</code> 算出平均與最高最低</li>\n      <li>插入一張<strong>折線圖</strong>，加上標題與單位</li>\n      <li>寫出 <strong>1 個洞見</strong>：你從資料裡發現了什麼？</li>\n    </ul>\n  </div>\n  <div style='background:#fffbeb;border-radius:12px;padding:16px;'>\n    <h3 style='color:#92400e;font-size:1rem;margin-bottom:8px;'>📏 評分（規準一）</h3>\n    <table style='width:100%;font-size:.79rem;color:#334155;border-collapse:collapse;'>\n      <tr><td style='padding:5px 0;width:14%;'><strong style='color:#059669;'>A</strong></td><td>地圖與試算表都完成，圖表格式正確，洞見具體且與資料相符</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#2563eb;'>B</strong></td><td>兩項都完成，能正確表達資料意涵</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#d97706;'>C</strong></td><td>在引導下完成主要項目，能簡單說明</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#dc2626;'>D</strong></td><td>僅完成部分基本功能</td></tr>\n    </table>\n    <div style='background:#fff;border-radius:8px;padding:10px;margin-top:10px;'>\n      <p style='font-size:.78rem;color:#475569;margin:0;line-height:1.75;'>⚠️ <strong>隱私提醒</strong>：地圖標記<strong>不要標出你家的確切門牌</strong>，可以用附近的路口或商店代替。這就是「數位足跡」的實際練習。</p>\n    </div>\n  </div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🏆 <strong>加分挑戰</strong>：到「政府資料開放平臺」下載一份你有興趣的資料（例如各行政區的公園數量），畫成圖表並寫下發現。</p>\n</div>"}, {"id": 22, "chapter": "課堂實作", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 3 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>大數據 4V</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>Volume 大量、Velocity 快速、Variety 多樣、Veracity 真實性</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>資料科學四步驟</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>收集 → 清理 → 找模式 → 預測；清理最花時間也最重要</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>相關 ≠ 因果</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>兩件事一起發生，不代表其中一件造成另一件</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>雲端運算</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>資料存在別人的機房；分享權限設錯＝自己公開資料</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>有了海量資料與便宜的雲端運算，機器終於學得會東西了。</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：人工智慧與機器學習</p>\n</div>"}]