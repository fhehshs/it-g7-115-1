[{"id": 1, "chapter": "封面", "title": "大數據與雲端運算", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>☁️</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>大數據與雲端運算</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Big Data &amp; Cloud Computing</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📊 4V</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔬 資料科學</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🗺️ Google 工具實作</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 3 週</p>\n</div>"}, {"id": 2, "chapter": "第一節：資料變成大數據", "title": "課前暖身：資料到底有多大？", "bg": "navy", "quiz": null, "chart": null, "video": {"type": "both", "id": "EWUA-9QkZxo", "title": "大數據到底有多大？", "query": "大數據 是什麼 中文 介紹", "search_title": "影片打不開？點這裡找替代影片", "desc": "在 YouTube 搜尋「大數據 是什麼」，挑一支中文短片"}, "html": "\n<h2 style='color:#fff;font-size:1.45rem;font-weight:700;margin-bottom:4px;'>🎬 先看一段影片</h2>\n<p style='color:#93c5fd;font-size:.86rem;margin-bottom:11px;'>看的時候，把這三個問題放在心上 👇</p>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:12px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:11px 13px;'>\n    <div style='color:#fbbf24;font-size:.78rem;font-weight:800;margin-bottom:3px;'>Q1</div>\n    <p style='color:#e2e8f0;font-size:.8rem;margin:0;line-height:1.6;'>影片裡出現最<strong>誇張</strong>的一個數字是什麼？</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:11px 13px;'>\n    <div style='color:#fbbf24;font-size:.78rem;font-weight:800;margin-bottom:3px;'>Q2</div>\n    <p style='color:#e2e8f0;font-size:.8rem;margin:0;line-height:1.6;'>這些資料是<strong>誰</strong>產生的？有沒有你的一份？</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:11px 13px;'>\n    <div style='color:#fbbf24;font-size:.78rem;font-weight:800;margin-bottom:3px;'>Q3</div>\n    <p style='color:#e2e8f0;font-size:.8rem;margin:0;line-height:1.6;'>資料變這麼多，會帶來什麼<strong>好處</strong>與<strong>麻煩</strong>？</p></div>\n</div>\n<div id='video-section-2' class='video-section'></div>\n<div style='background:rgba(13,148,136,.25);border-left:4px solid #0d9488;border-radius:8px;padding:10px 15px;margin-top:12px;'>\n  <p style='color:#f0fdfa;font-size:.85rem;margin:0;'>💬 <strong>看完先別急著往下</strong>：和旁邊的同學各說一個「你覺得最誇張」的地方，等一下我們就來拆解——為什麼這叫「<strong>大</strong>數據」。</p>\n</div>"}, {"id": 3, "chapter": "第一節：資料變成大數據", "title": "從資料到大數據", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>從「一筆資料」到「大數據」</h2>\n<div style='display:flex;align-items:stretch;gap:8px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>📝</div><strong style='color:#1e40af;font-size:.88rem;'>資料 Data</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「7A」、「32」<br>單獨的數字與代號，看不出在講什麼</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.3rem;'>&#8594;</div>\n  <div style='background:#f0fdf4;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>📋</div><strong style='color:#166534;font-size:.88rem;'>資訊 Information</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「7A 班有 32 人」<br>整理過、看得懂了</p></div>\n  <div style='display:flex;align-items:center;color:#94a3b8;font-size:1.3rem;'>&#8594;</div>\n  <div style='background:#fefce8;border-radius:11px;padding:14px;flex:1;text-align:center;'>\n    <div style='font-size:1.6rem;'>💡</div><strong style='color:#854d0e;font-size:.88rem;'>知識 Knowledge</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;'>「全校人數逐年下降，明年要少開一班」<br>看得出該怎麼做的判斷</p></div>\n</div>\n<div style='background:#f5f3ff;border-radius:11px;padding:13px 16px;margin-bottom:10px;border-left:4px solid #7c3aed;'>\n  <p style='margin:0;color:#334155;font-size:.87rem;line-height:1.85;'>\n    📊 <strong style='color:#5b21b6;'>那大數據是第四階嗎？不是。</strong>當最左邊的「資料」多到<strong>全國、十年、每秒都還在增加</strong>，就叫大數據——它講的是<strong>資料的規模</strong>，不是知識的下一步。</p>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:10px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.9rem;line-height:1.8;'>📖 <strong>大數據</strong>：資料量大到<strong>一台個人電腦、用一般常見的軟體就處理不動</strong>，必須靠很多台電腦一起分工（這叫<strong>分散式運算</strong>）才分析得完。</p>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.89rem;margin:0;'>💬 <strong>想一想</strong>：你今天用手機產生了哪些資料？（搜尋、按讚、位置、看影片的秒數…）這些資料最後去了哪裡、誰在用？</p>\n</div>"}, {"id": 4, "chapter": "第一節：資料變成大數據", "title": "大數據的 4V", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📊 大數據的四個特性（4V）</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:linear-gradient(135deg,#1e3a8a,#3b82f6);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>📦</div>\n    <strong style='font-size:1rem;'>Volume 大量</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料量龐大到單機處理不來。一部 4K 電影約幾十 GB，全球每天上傳的影片加起來是天文數字。</p></div>\n  <div style='background:linear-gradient(135deg,#065f46,#0d9488);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>⚡</div>\n    <strong style='font-size:1rem;'>Velocity 快速</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料即時產生、也要即時分析。地震速報要在幾秒內判斷並發警報，慢一秒就沒用了。</p></div>\n  <div style='background:linear-gradient(135deg,#9a3412,#f97316);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>🎨</div>\n    <strong style='font-size:1rem;'>Variety 多樣</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>文字、圖片、影片、聲音、感測器讀值、GPS 座標……格式全都不一樣，要先整理成能一起分析的形式。</p></div>\n  <div style='background:linear-gradient(135deg,#6b21a8,#a855f7);color:#fff;border-radius:12px;padding:15px;'>\n    <div style='font-size:1.5rem;'>✅</div>\n    <strong style='font-size:1rem;'>Veracity 真實性</strong>\n    <p style='font-size:.8rem;opacity:.92;margin-top:6px;line-height:1.75;'>資料準不準確？感測器有沒有故障？問卷有沒有亂填？錯的資料會導出錯的決策。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>🧠 <strong>記憶口訣</strong>：<strong>又多、又快、又雜、還不一定對</strong>——這就是大數據難搞的地方，也是它需要專門技術的原因。<br>\n  <span style='color:#64748b;font-size:.83rem;'>（有些課本的第四個 V 是 <strong>Value 價值</strong>——資料要能產生價值才有意義。兩種說法都常見，看你手上的課本怎麼寫。）</span></p>\n</div>"}, {"id": 5, "chapter": "第一節：資料變成大數據", "title": "大數據就在你身邊", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🇹🇼 大數據就在你身邊 — 台灣在地案例</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;border-left:5px solid #2563eb;'>\n    <strong style='color:#1e40af;font-size:.95rem;'>🏥 全民健保資料</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>台灣全民健保累積了長期、涵蓋幾乎全體國民的就醫紀錄，因為幾乎每個人都有健保卡，它成為國際上少見的大型健康資料庫，常被用於公共衛生與醫療研究（研究使用須經去識別化與審查）。</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-left:5px solid #16a34a;'>\n    <strong style='color:#166534;font-size:.95rem;'>🚲 YouBike 使用紀錄</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>每一次借還車都是一筆資料。分析後可以知道哪些站點早上永遠沒車、哪些站點晚上永遠停滿，用來調度車輛、決定新站點要設在哪。</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;border-left:5px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:.95rem;'>🚌 公車與捷運刷卡資料</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>電子票證讓每一次進出站都有紀錄，可以看出通勤尖峰、轉乘熱點，用來調整班次與規劃新路線。</p></div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-left:5px solid #dc2626;'>\n    <strong style='color:#991b1b;font-size:.95rem;'>🌏 政府資料開放平臺</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>空氣品質、雨量、停車位、實價登錄、農產品價格……政府把資料免費開放，任何人（包含你）都可以下載來做分析與應用。</p></div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🔗 想找資料做專題？搜尋「<strong>政府資料開放平臺</strong>」（data.gov.tw）或「<strong>臺北市資料大平臺</strong>」（data.taipei），裡面有上萬筆免費、可合法使用的資料集——記得<strong>標示資料來源</strong>。</p>\n</div>"}, {"id": 6, "chapter": "第一節：資料變成大數據", "title": "大數據的兩難", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>⚖️ 大數據的兩難：便利與監控只有一線之隔</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>👍 大數據幫我們做到</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>疫情期間追蹤疫調、預測物資需求</li>\n      <li>從交通資料改善壅塞與事故熱點</li>\n      <li>從醫療資料發現疾病的早期徵兆</li>\n      <li>推薦你可能真的會喜歡的內容</li>\n    </ul>\n  </div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;'>\n    <h3 style='color:#991b1b;font-size:1rem;margin-bottom:8px;'>👎 但同時也可能</h3>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.95;padding-left:18px;margin:0;'>\n      <li>把你的行蹤、喜好拼湊成完整檔案</li>\n      <li>用「只推你愛看的東西」慢慢影響你的想法</li>\n      <li>把你關進只看得到同類意見的同溫層</li>\n      <li>資料一旦外洩，影響長久且難以挽回</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:10px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    🔐 <strong style='color:#fbbf24;'>關鍵概念：去識別化</strong><br>\n    要拿大量個人資料來做研究之前，得先把姓名、身分證字號這種「一看就知道是誰」的欄位拿掉，或換成無法還原的代碼。<br>\n    ⚠️ <strong style='color:#fca5a5;'>但拿掉姓名還不夠</strong>——只要留下「生日＋性別＋住哪一區」，常常就能反推出是誰。所以真正的標準是：<strong>處理到再也對不回特定的人</strong>為止。第 4 週會再深入。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💬 <strong>討論</strong>：如果政府要用手機定位資料來做防疫追蹤，你贊成嗎？需要加上哪些條件（例如期限、監督、事後刪除）你才會接受？</p>\n</div>"}, {"id": 7, "chapter": "第一節：資料變成大數據", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>大數據與 4V ｜ 3 題</p>\n</div>"}, {"id": 8, "chapter": "第二節：資料科學四步驟", "title": "資料科學四步驟", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔬 資料科學：從資料中挖出有用的知識</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:14px;'>\n    <div style='background:#2563eb;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>1</div>\n    <strong style='color:#1e40af;font-size:.88rem;'>收集資料</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>感測器、問卷、交易紀錄、開放資料</p></div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:14px;'>\n    <div style='background:#16a34a;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>2</div>\n    <strong style='color:#166534;font-size:.88rem;'>資料清理</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>去除重複、錯誤、缺漏，統一格式</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:14px;'>\n    <div style='background:#eab308;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>3</div>\n    <strong style='color:#854d0e;font-size:.88rem;'>找出模式</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>用統計與演算法找出規律與關聯</p></div>\n  <div style='background:#f5f3ff;border-radius:12px;padding:14px;'>\n    <div style='background:#7c3aed;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;margin-bottom:7px;'>4</div>\n    <strong style='color:#5b21b6;font-size:.88rem;'>預測與決策</strong>\n    <p style='font-size:.75rem;color:#475569;margin-top:5px;line-height:1.65;'>建立模型，根據歷史推測未來</p></div>\n</div>\n<div style='background:#f1f5f9;border-radius:10px;padding:13px 16px;margin-bottom:10px;'>\n  <p style='color:#334155;font-size:.87rem;margin:0;line-height:1.9;'>\n    🎬 <strong>用「串流平台怎麼知道你喜歡看什麼」走一遍</strong>：<br>\n    ① 記錄你看了哪些片、看多久、有沒有跳過 → ② 排除誤點開、家人共用等雜訊 → ③ 找出「看過 A 的人也常看 B」的規律 → ④ 推薦下一部給你</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>⏱️ <strong>冷知識</strong>：資料科學家常說，一個專案有<strong>大半時間花在第 2 步「清理」</strong>上。真實世界的資料，遠比課本上的漂亮表格髒得多。</p>\n</div>"}, {"id": 9, "chapter": "第二節：資料科學四步驟", "title": "髒資料長什麼樣", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧹 髒資料長什麼樣？（真實案例）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:22%;'>問題</th>\n    <th style='padding:7px;text-align:left;width:34%;'>例子</th>\n    <th style='padding:7px;text-align:left;'>怎麼處理</th></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>重複資料</td><td style='padding:7px;'>同一個人填了 3 次問卷</td><td style='padding:7px;'>依帳號或時間戳記去重複</td></tr>\n  <tr><td style='padding:7px;'>格式不一致</td><td style='padding:7px;'>「台北市」「臺北市」「北市」</td><td style='padding:7px;'>統一寫法（尋找與取代）</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>明顯錯誤值</td><td style='padding:7px;'>身高填 300、年齡填 999</td><td style='padding:7px;'>設定合理範圍，標記或排除</td></tr>\n  <tr><td style='padding:7px;'>缺漏值</td><td style='padding:7px;'>某幾天的溫度是空白</td><td style='padding:7px;'>標記為「無資料」，不要當成 0</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'>單位混用</td><td style='padding:7px;'>有人填公分、有人填公尺</td><td style='padding:7px;'>換算成同一單位</td></tr>\n</table>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>「缺漏 ≠ 0」是最常見的致命錯誤</strong>：如果溫度沒測到卻填 0，算出來的平均氣溫會嚴重偏低。缺漏就標「無資料」，並在報告中說明有幾筆缺漏、你怎麼處理。</p>\n</div>"}, {"id": 10, "chapter": "第二節：資料科學四步驟", "title": "相關不等於因果", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🚨 資料素養最重要的一課：相關 ≠ 因果</h2>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:11px;'>\n  <p style='color:#fbbf24;font-size:.95rem;font-weight:700;margin-bottom:9px;'>🎮 「有電競鍵盤的人，遊戲段位比較高」→ 所以買鍵盤就會變強？</p>\n  <div style='display:flex;align-items:center;gap:9px;flex-wrap:wrap;'>\n    <div style='background:rgba(59,130,246,.2);border-radius:9px;padding:10px 14px;'>\n      <span style='color:#93c5fd;font-size:.84rem;'>⌨️ 有電競鍵盤</span></div>\n    <span style='color:#cbd5e1;'>&#8596;</span>\n    <div style='background:rgba(239,68,68,.2);border-radius:9px;padding:10px 14px;'>\n      <span style='color:#fca5a5;font-size:.84rem;'>🏆 段位比較高</span></div>\n    <span style='color:#cbd5e1;margin:0 4px;'>兩者其實都來自 →</span>\n    <div style='background:rgba(245,158,11,.25);border-radius:9px;padding:10px 14px;'>\n      <span style='color:#fbbf24;font-size:.84rem;font-weight:700;'>🔥 本來就很投入（練很久、也願意花錢）</span></div>\n  </div>\n  <p style='color:#cbd5e1;font-size:.81rem;margin-top:11px;'>就算好鍵盤真的有一點點幫助，也<strong>遠遠不足以解釋段位的差距</strong>——真正的差別是「有沒有認真練」。是「很認真玩」的人<strong>同時</strong>會練很久<strong>也</strong>會買裝備。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:11px;'>\n  <div style='background:#eff6ff;border-radius:11px;padding:13px;'>\n    <strong style='color:#1e40af;font-size:.87rem;'>① 有第三個原因</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>「鞋子尺寸越大的小孩，認得的字越多」<br>\n    <span style='color:#0d9488;'>→ 真正原因是<strong>年齡</strong>，不是腳變大會識字</span></p></div>\n  <div style='background:#fff7ed;border-radius:11px;padding:13px;'>\n    <strong style='color:#9a3412;font-size:.87rem;'>② 因果反過來了</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>「常跑醫院的人比較不健康」<br>\n    <span style='color:#0d9488;'>→ 不是看醫生害的，是<strong>先不舒服才去看</strong></span></p></div>\n  <div style='background:#f5f3ff;border-radius:11px;padding:13px;'>\n    <strong style='color:#5b21b6;font-size:.87rem;'>③ 純屬巧合</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>兩條毫不相干的曲線剛好一起上升<br>\n    <span style='color:#0d9488;'>→ 資料夠多，總會撞出<strong>假關係</strong></span></p></div>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;'>\n  <div style='background:#f0fdf4;border-radius:10px;padding:13px;'>\n    <strong style='color:#166534;font-size:.88rem;'>✅ 正確的說法</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「資料顯示這兩者<strong>有相關</strong>，可能的原因是…，還需要進一步驗證。」</p></div>\n  <div style='background:#fef2f2;border-radius:10px;padding:13px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>❌ 危險的說法</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>「資料<strong>證明</strong>了 A <strong>導致</strong> B。」——專題報告寫這句會被扣分。</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;margin-top:11px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💬 <strong>換你想</strong>：「打籃球的同學數學比較好」、「聽某種音樂讀書比較有效率」——這些說法，你想得到可能的<strong>第三個原因</strong>嗎？</p>\n</div>"}, {"id": 11, "chapter": "第二節：資料科學四步驟", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>資料科學與資料素養 ｜ 3 題</p>\n</div>"}, {"id": 12, "chapter": "第三節：雲端運算", "title": "什麼是雲端運算", "bg": "white", "quiz": null, "chart": null, "video": {"query": "雲端運算 是什麼 三分鐘 中文", "title": "延伸影片：三分鐘認識雲端運算", "desc": "在 YouTube 搜尋「雲端運算 是什麼」，看看資料中心長什麼樣"}, "html": "\n<h2 class='slide-title'>☁️ 雲端運算：把運算與儲存搬到網路上</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:12px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.92rem;line-height:1.8;'>📖 透過<strong>網際網路</strong>提供的運算服務（伺服器、儲存空間、軟體），<strong>需要多少用多少</strong>，不必自己買設備。<br>\n  <span style='color:#64748b;font-size:.83rem;'>（個人使用通常有<strong>免費額度</strong>，所以你用起來不用錢；公司或學校用量大時才會按用量付費。）</span></p>\n</div>\n<div style='background:#1e293b;border-radius:12px;padding:16px;margin-bottom:12px;'>\n  <p style='color:#fbbf24;font-size:.92rem;font-weight:700;margin-bottom:8px;'>💡 破解迷思：「雲端」其實一點也不在天上</p>\n  <p style='color:#e2e8f0;font-size:.84rem;margin:0;line-height:1.9;'>\n    你的照片、作業並不是飄在雲裡，而是存在<strong>某個國家、某座資料中心、某台實體伺服器的硬碟</strong>上。「雲」只是一個比喻：你不需要知道它在哪，需要時打開網路就拿得到。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.87rem;'>💰 省成本</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>不用買伺服器、不用養機房，需求變大再加租</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.87rem;'>🔄 隨處存取</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>手機、平板、電腦登入同一帳號就能接續工作</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.87rem;'>💾 自動備份</strong>\n    <p style='font-size:.77rem;color:#475569;margin-top:5px;line-height:1.7;'>有版本紀錄，改壞了可以還原成昨天的版本</p></div>\n</div>\n<div id='video-section-12' class='video-section'></div>"}, {"id": 13, "chapter": "第三節：雲端運算", "title": "你每天都在用的雲端", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>📱 你每天都在用的雲端服務</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:26%;'>你在做的事</th>\n    <th style='padding:7px;text-align:left;'>背後的雲端運算</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📧 收發 Gmail</td><td style='padding:7px;'>信件存在 Google 的伺服器，換裝置登入都看得到</td></tr>\n  <tr><td style='padding:7px;'>📄 用 Google 文件寫作業</td><td style='padding:7px;'>不用按存檔，每次修改都即時同步到雲端並留下版本</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📸 手機照片自動備份</td><td style='padding:7px;'>手機掉了照片還在；也代表照片副本存在別人的機房</td></tr>\n  <tr><td style='padding:7px;'>🎮 玩雲端遊戲</td><td style='padding:7px;'>畫面在遠端伺服器算好再串流給你，手機不用很強也跑得動大作</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>🤖 和 AI 聊天</td><td style='padding:7px;'>模型跑在資料中心的大量 GPU 上，不是在你的手機裡</td></tr>\n</table>\n<div style='background:#fef2f2;padding:12px 16px;border-radius:8px;border-left:4px solid #dc2626;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ⚠️ <strong>雲端的另一面</strong>：<br>\n    ① <strong>沒網路就用不了</strong>（離線功能有限）　② <strong>資料存在別人的機房</strong>，要看清楚服務條款　③ <strong>分享權限設錯就等於公開</strong>　④ 服務可能終止或改變收費</p>\n</div>"}, {"id": 14, "chapter": "第三節：雲端運算", "title": "雲端分享權限", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔑 分享權限：外洩最常見的原因是「自己設錯」</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;border-top:5px solid #16a34a;'>\n    <strong style='color:#166534;font-size:.92rem;'>🔒 限制存取</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>只有你和你指定的人看得到。<br><strong>最安全</strong>，繳交作業時把老師加進來即可。</p></div>\n  <div style='background:#fefce8;border-radius:12px;padding:15px;border-top:5px solid #eab308;'>\n    <strong style='color:#854d0e;font-size:.92rem;'>🏫 校內知道連結者</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>限學校帳號才打得開。<br><strong>小組共編適用</strong>，記得選「檢視」或「編輯」要正確。</p></div>\n  <div style='background:#fef2f2;border-radius:12px;padding:15px;border-top:5px solid #dc2626;'>\n    <strong style='color:#991b1b;font-size:.92rem;'>🌐 網路上任何人</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:6px;line-height:1.75;'>全世界都能開。<br><strong>只用在真的要公開的東西</strong>，且絕不能給「編輯」權限。</p></div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;margin-bottom:10px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    ✅ <strong>三個好習慣</strong>：① 分享前先問「這份東西需要誰看得到？」② 給「檢視」就不要給「編輯」　③ 專題做完後回頭把不需要的分享權限收回來。</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>🧪 <strong>課堂小測試</strong>：複製你的作業連結，開一個<strong>無痕視窗（沒有登入任何帳號）</strong>貼上去看看——<br>\n  ・打不開 → 你設的是「限制存取」，最安全<br>\n  ・要求登入學校帳號 → 「校內知道連結者」，小組共編剛好<br>\n  ・<strong style='color:#dc2626;'>直接就打開了 → 你設成了「知道連結的任何人」，等於全世界都看得到</strong></p>\n</div>"}, {"id": 15, "chapter": "第三節：雲端運算", "title": "雲端與大數據的關係", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>🔗 把三週的內容串起來</h2>\n<div style='background:rgba(255,255,255,.12);border-radius:12px;padding:18px;margin-bottom:12px;'>\n  <div style='display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;'>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>📡</div><strong style='color:#fff;font-size:.86rem;'>IoT 感測器</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>持續產生資料</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>☁️</div><strong style='color:#fff;font-size:.86rem;'>雲端儲存</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>資料集中存放</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>📊</div><strong style='color:#fff;font-size:.86rem;'>大數據分析</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>找出規律</p></div>\n    <span style='color:#fbbf24;font-size:1.4rem;'>&#8594;</span>\n    <div style='background:rgba(255,255,255,.15);border-radius:10px;padding:13px;flex:1;min-width:120px;text-align:center;'>\n      <div style='font-size:1.6rem;'>🤖</div><strong style='color:#fff;font-size:.86rem;'>AI 學習</strong>\n      <p style='color:#ccfbf1;font-size:.73rem;margin-top:4px;'>下週的主題</p></div>\n  </div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:13px 18px;'>\n  <p style='color:#f0fdfa;font-size:.9rem;margin:0;line-height:1.9;'>\n    🧠 <strong>為什麼 AI 這幾年突然變強？</strong>因為這三件事同時到位了：<strong>IoT 與網路產生了海量資料</strong>、<strong>雲端提供了便宜的儲存與運算</strong>、<strong>晶片（GPU／NPU）跑得夠快</strong>。<br>\n    沒有資料，再厲害的 AI 也學不會東西——這就是下一週的起點。</p>\n</div>"}, {"id": 16, "chapter": "第三節：雲端運算", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>雲端運算與分享權限 ｜ 3 題</p>\n</div>"}, {"id": 17, "chapter": "第四節：Google 工具組實作", "title": "Google 雲端工具總覽", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧰 Google 雲端工具 — 猜猜看：哪幾個是你<span style='color:#0d9488;'>今天已經用過</span>的？</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:11px;'>\n  <div style='background:#fef2f2;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>📁</div><strong style='color:#991b1b;font-size:.88rem;'>雲端硬碟 Drive</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>所有檔案的家，可分享、可還原舊版本</p></div>\n  <div style='background:#ecfeff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>📄</div><strong style='color:#155e75;font-size:.88rem;'>文件 Docs</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>共同編輯、留言、語音輸入</p></div>\n  <div style='background:#f5f3ff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>📊</div><strong style='color:#5b21b6;font-size:.88rem;'>簡報 Slides</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>多人同時做一份，專題必用</p></div>\n  <div style='background:#fefce8;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>📋</div><strong style='color:#854d0e;font-size:.88rem;'>表單 Forms</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>做問卷、自動統計、可當線上測驗</p></div>\n  <div style='background:#f0fdf4;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>🗺️</div><strong style='color:#166534;font-size:.88rem;'>地圖 Maps / My Maps</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>路線規劃、街景、自製主題地圖</p></div>\n  <div style='background:#eff6ff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>🖼️</div><strong style='color:#1e40af;font-size:.88rem;'>相簿 Photos</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>自動備份、以圖搜圖、自動分類</p></div>\n  <div style='background:#f0fdf4;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>🔍</div><strong style='color:#166534;font-size:.88rem;'>Lens 智慧鏡頭</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>拍照認植物、認題目、擷取文字</p></div>\n  <div style='background:#eff6ff;padding:14px;border-radius:11px;'>\n    <div style='font-size:1.6rem;'>🌐</div><strong style='color:#1e40af;font-size:.88rem;'>翻譯 Translate</strong>\n    <p style='font-size:.76rem;color:#475569;margin-top:5px;line-height:1.65;'>鏡頭即時翻譯招牌菜單、對話模式</p></div>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>🎯 <strong>等一下挑工具的三個原則</strong>：① 挑<strong>你真的會用</strong>的（才寫得出心得）　② 兩個要<strong>不同類型</strong>（例如一個文書、一個地圖或影像）　③ 挑<strong>你講得出缺點</strong>的。<br>\n  <span style='color:#64748b;font-size:.83rem;'>💡 不限這 12 個，Gmail、YouTube、Meet、Classroom 也都算 Google 的雲端工具。</span></p>\n</div>"}, {"id": 18, "chapter": "第四節：Google 工具組實作", "title": "Google 地圖：路線規劃與街景", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🗺️ Google 地圖：規劃一趟真的走得到的行程</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:11px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:15px;'>\n    <h3 style='color:#1e40af;font-size:.98rem;margin-bottom:8px;'>🧭 路線規劃四步驟</h3>\n    <ol style='color:#334155;font-size:.82rem;line-height:1.9;padding-left:20px;margin:0;'>\n      <li>輸入<strong>起點（學校）</strong>與<strong>終點</strong>，按「路線」</li>\n      <li>切換<strong>交通工具</strong>：開車 🚗／大眾運輸 🚌／步行 🚶／單車 🚲<br>\n        <span style='color:#64748b;font-size:.77rem;'>不同工具的時間、費用、路線完全不一樣</span></li>\n      <li>點「<strong>出發時間</strong>」設成上午 09:00 ——<br>\n        <span style='color:#64748b;font-size:.77rem;'>系統會用那個時段的班次與路況估算，比預設準得多</span></li>\n      <li>開車／步行／單車模式可按「<strong>新增目的地</strong>」串成多站行程<br>\n        <span style='color:#64748b;font-size:.77rem;'>⚠️ 大眾運輸模式不支援多站，要分段查（學校→A 查一次、A→B 再查一次）</span></li>\n    </ol>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:15px;'>\n    <h3 style='color:#166534;font-size:.98rem;margin-bottom:8px;'>👀 街景（Street View）怎麼用</h3>\n    <p style='font-size:.82rem;color:#475569;line-height:1.85;margin:0 0 7px;'>\n      💻 電腦：把右下角的<strong>小黃人</strong>拖到地圖上。<br>\n      📱 手機：點一下地點 → 往上滑找「<strong>街景服務</strong>」，或點縮圖中有 360° 標記的照片。</p>\n    <p style='font-size:.82rem;color:#475569;line-height:1.85;margin:0;'>\n      <strong>出發前先「走」一次</strong>，你可以確認：<br>\n      • 出口在哪一邊、要不要過馬路<br>\n      • 公車站牌長什麼樣子、好不好認<br>\n      • 目的地門口的樣子（才不會走過頭）<br>\n      • 沿路有沒有樓梯或無障礙坡道</p>\n  </div>\n</div>\n<div style='background:#f5f3ff;padding:11px 16px;border-radius:8px;border-left:4px solid #7c3aed;margin-bottom:9px;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>🗺️ <strong>My Maps（我的地圖）</strong>：想把好幾個地點畫成一張<strong>自己的主題地圖</strong>（例如「學校周邊美食地圖」），可以用 My Maps 建立圖層、加標記、放照片與說明，再分享給同學。</p>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.87rem;margin:0;'>🧠 <strong>它背後就是這三週的內容</strong>：手機與車輛回報位置（<strong>IoT</strong>）→ 上傳到 Google 機房（<strong>雲端</strong>）→ 分析整個城市的車流（<strong>大數據</strong>）→ 算出「現在走這條最快」。你每天用的導航，就是一台大數據機器。</p>\n</div>"}, {"id": 19, "chapter": "第四節：Google 工具組實作", "title": "怎麼「介紹」一個工具", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>✍️ 怎麼「介紹」一個工具？（作業就照這五格寫）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:11px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:22%;'>要寫什麼</th>\n    <th style='padding:7px;text-align:left;width:30%;'>❌ 這樣寫拿不到分</th>\n    <th style='padding:7px;text-align:left;'>✅ 這樣寫才具體</th></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'><strong>名稱</strong></td>\n    <td style='padding:7px;color:#991b1b;'>「翻譯」</td>\n    <td style='padding:7px;color:#166534;'>「Google 翻譯（Google Translate）」</td></tr>\n  <tr><td style='padding:7px;'><strong>用途</strong></td>\n    <td style='padding:7px;color:#991b1b;'>「可以翻譯，很方便」</td>\n    <td style='padding:7px;color:#166534;'>「文字翻譯、鏡頭即時翻譯招牌與菜單、對話模式雙向口譯、可整份文件翻譯」</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'><strong>應用實例</strong></td>\n    <td style='padding:7px;color:#991b1b;'>「大家都在用」</td>\n    <td style='padding:7px;color:#166534;'>「我用鏡頭對著英文說明書，畫面上的字立刻變成中文」（<strong>附操作截圖</strong>）</td></tr>\n  <tr><td style='padding:7px;'><strong>選它的原因<br>（使用心得）</strong></td>\n    <td style='padding:7px;color:#991b1b;'>「因為很好用」</td>\n    <td style='padding:7px;color:#166534;'>「我看英文遊戲介面常卡住，這個工具解決了我『一個字一個字查很慢』的困擾」</td></tr>\n  <tr style='background:#f8fafc;'><td style='padding:7px;'><strong>優點／缺點<br>／改進方向</strong></td>\n    <td style='padding:7px;color:#991b1b;'>「優點是方便，缺點是沒有」</td>\n    <td style='padding:7px;color:#166534;'>「優點：拍照就能翻。缺點：手寫字常常辨識錯。改進：希望能一次翻整頁，不用一行一行對」</td></tr>\n</table>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;margin-bottom:9px;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;line-height:1.85;'>\n    🎯 <strong>拿高分的關鍵只有一句</strong>：寫「<strong>你自己實際操作後發現的事</strong>」，而不是抄官方介紹。<br>\n    <span style='color:#64748b;font-size:.83rem;'>這五格套在任何工具上都適用，不是只有翻譯能這樣寫。</span></p>\n</div>\n<div style='background:#ecfdf5;padding:11px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>✍️ <strong>30 秒動手</strong>：現在就用一句話寫下你想介紹的<strong>第一個工具的「缺點」</strong>。<br>\n  <span style='color:#64748b;font-size:.83rem;'>想不出來？那代表你要先去玩五分鐘——說得出缺點，才代表你真的用過。</span></p>\n</div>"}, {"id": 20, "chapter": "第四節：Google 工具組實作", "title": "期末災難現場：六個好習慣", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>😱 期末災難現場（每一屆都真的發生過）</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:11px;'>\n  <div style='background:#fef2f2;padding:12px;border-radius:10px;border-left:4px solid #dc2626;'>\n    <p style='color:#991b1b;font-size:.82rem;margin:0 0 4px;'>😵 「老師我交了啊！」——老師收到 30 份<strong>「未命名文件」</strong></p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 檔名寫 <code>座號_姓名_作業名稱</code></p></div>\n  <div style='background:#fff7ed;padding:12px;border-radius:10px;border-left:4px solid #f97316;'>\n    <p style='color:#9a3412;font-size:.82rem;margin:0 0 4px;'>😩 期末要交學習歷程，<strong>在 200 個檔案裡翻了半小時</strong></p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 一科一個資料夾，現在就建好</p></div>\n  <div style='background:#fefce8;padding:12px;border-radius:10px;border-left:4px solid #eab308;'>\n    <p style='color:#854d0e;font-size:.82rem;margin:0 0 4px;'>😭 組員不小心<strong>刪光了整份簡報</strong></p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 「檔案 → 版本記錄」可以還原，還看得到是誰改的</p></div>\n  <div style='background:#f5f3ff;padding:12px;border-radius:10px;border-left:4px solid #7c3aed;'>\n    <p style='color:#5b21b6;font-size:.82rem;margin:0 0 4px;'>😠 「這都是我做的！」<strong>但沒人證明得了</strong></p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 組員加入為<strong>「編輯者」</strong>，每頁註明負責人</p></div>\n  <div style='background:#fef2f2;padding:12px;border-radius:10px;border-left:4px solid #dc2626;'>\n    <p style='color:#991b1b;font-size:.82rem;margin:0 0 4px;'>😰 有人把<strong>身分證字號打進小組共用文件</strong>，全班都看得到</p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 敏感資料一律不進共用檔</p></div>\n  <div style='background:#ecfeff;padding:12px;border-radius:10px;border-left:4px solid #06b6d4;'>\n    <p style='color:#155e75;font-size:.82rem;margin:0 0 4px;'>😨 用完沒登出，<strong>下一節課的人打開了你的雲端硬碟</strong></p>\n    <p style='font-size:.78rem;color:#166534;margin:0;'>✅ 公用電腦一定要登出</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🙋 <strong>現在做</strong>：打開你的雲端硬碟，看看有幾個「未命名文件」——<strong>超過 3 個的舉手</strong>。順便把 <code>115-1 資訊科技</code> 資料夾建好。</p>\n</div>"}, {"id": 21, "chapter": "第四節：Google 工具組實作", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>Google 雲端工具與地圖 ｜ 4 題</p>\n</div>"}, {"id": 22, "chapter": "課堂實作", "title": "Google 雲端工具應用介紹", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎯 課堂實作：Google 雲端工具應用介紹（500 字以上）</h2>\n<div style='background:#f1f5f9;border-radius:9px;padding:9px 14px;margin-bottom:10px;'>\n  <p style='color:#334155;font-size:.83rem;margin:0;'>📄 用 Google 文件撰寫，檔名 <code>座號_姓名_Google雲端工具應用介紹</code>，完成後把老師<strong>加入為「檢視者」</strong>（不要設成「網路上任何人」）。</p>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:10px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:14px;'>\n    <h3 style='color:#1e40af;font-size:.96rem;margin-bottom:7px;'>1️⃣ 2️⃣ 介紹兩個 Google 雲端工具</h3>\n    <p style='font-size:.79rem;color:#64748b;margin:0 0 6px;'>每個工具都要寫齊這五項：</p>\n    <ul style='color:#334155;font-size:.81rem;line-height:1.8;padding-left:18px;margin:0;'>\n      <li><strong>名稱</strong></li>\n      <li><strong>用途</strong></li>\n      <li><strong>工具介紹應用實例</strong>（附操作截圖）</li>\n      <li><strong>選擇介紹這個工具的原因</strong>（使用心得）</li>\n      <li><strong>優點、缺點或改進方向</strong></li>\n    </ul>\n    <p style='font-size:.78rem;color:#0d9488;margin-top:7px;'>💡 兩個工具要<strong>不同類型</strong>（例如一個文書、一個地圖），別選兩個很像的。</p>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:14px;'>\n    <h3 style='color:#166534;font-size:.96rem;margin-bottom:7px;'>3️⃣ 規劃一趟科技教育參訪路線</h3>\n    <p style='font-size:.79rem;color:#64748b;margin:0 0 6px;'>設定一個想了解科技教育的地點，<strong>從學校上午 09:00 出發</strong>，和同學一起規劃路線並互相分享：</p>\n    <ul style='color:#334155;font-size:.81rem;line-height:1.8;padding-left:18px;margin:0;'>\n      <li><strong>地點名稱</strong></li>\n      <li><strong>主題或目的</strong>（去那裡想了解什麼？）</li>\n      <li><strong>交通工具</strong></li>\n      <li><strong>路線規劃</strong>（含所需時間，附截圖）</li>\n      <li><strong>街景圖示</strong>（放一張街景截圖）</li>\n      <li><strong>這趟路線的優點、缺點或改進建議</strong><br>\n        <span style='color:#64748b;font-size:.77rem;'>例：優點是全程只轉乘一次；缺點是下車後還要走 800 公尺，下雨天很不方便；改進：也許改騎 YouBike 接駁</span></li>\n    </ul>\n  </div>\n</div>\n<div style='display:grid;grid-template-columns:1.15fr 1fr;gap:11px;'>\n  <div style='background:#fffbeb;border-radius:11px;padding:13px;'>\n    <strong style='color:#92400e;font-size:.9rem;'>📏 評分（規準一）</strong>\n    <table style='width:100%;font-size:.78rem;color:#334155;border-collapse:collapse;margin-top:5px;'>\n      <tr><td style='padding:4px 0;width:12%;'><strong style='color:#059669;'>A</strong></td><td>三題完整、字數達標，能有系統整合截圖與文字說明，優缺點具體且是自己操作後的發現</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#2563eb;'>B</strong></td><td>三題完成，能正確表達工具的用途與心得</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#d97706;'>C</strong></td><td>在引導下完成主要項目，能簡單說明</td></tr>\n      <tr><td style='padding:4px 0;'><strong style='color:#dc2626;'>D</strong></td><td>僅完成部分項目</td></tr>\n    </table>\n  </div>\n  <div style='background:#fef2f2;border-radius:11px;padding:13px;'>\n    <strong style='color:#991b1b;font-size:.9rem;'>⚠️ 兩個提醒</strong>\n    <p style='font-size:.79rem;color:#475569;margin-top:5px;line-height:1.75;'>\n      <strong>① 不要抄官方說明。</strong>要寫你自己操作後發現的事，尤其是缺點。<br>\n      <strong>② 起點寫「學校」就好</strong>，不要放自己家的確切地址——這是第 4 週「數位足跡」的實際練習。</p>\n  </div>\n</div>"}, {"id": 23, "chapter": "課堂實作", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 3 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>大數據 4V</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>Volume 大量、Velocity 快速、Variety 多樣、Veracity 真實性</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>資料科學四步驟</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>收集 → 清理 → 找模式 → 預測；清理最花時間也最重要</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>相關 ≠ 因果</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>可能有第三個原因、因果反過來，或純屬巧合——買裝備不會直接讓你變強</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>雲端運算</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>資料存在別人的機房；分享權限設錯＝自己公開資料</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>這些資料裡，有很大一部分就是「你」——那誰在保護它？</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：個人資料保護與數位足跡</p>\n</div>"}]