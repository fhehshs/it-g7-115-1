[{"id": 1, "chapter": "封面", "title": "課程導覽與數位公民起手式", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🚀</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>課程導覽與數位公民起手式</h1>\n  <h2 style='font-size:1.3rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Welcome to Information Technology</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📋 課前問卷</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔑 帳號設定</span>\n    <span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🗺️ 七大主題</span>\n  </div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第一學期 ｜ 第 1 週</p>\n  <p style='color:#64748b;font-size:.85rem;margin-top:8px;'>臺北市芳和實驗中學國中部 ｜ 許惠淑老師</p>\n</div>"}, {"id": 2, "chapter": "第一節：科技怎麼改變生活", "title": "時代飛躍的變遷", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>時代飛躍的變遷 — 15 年前，世界長什麼樣？</h2>\n<div style='background:#1e293b;border-radius:12px;padding:18px;margin-bottom:14px;'>\n  <div style='display:flex;justify-content:space-between;gap:6px;'>\n    <div style='text-align:center;flex:1;'>\n      <div style='font-size:1.7rem;'>📱</div>\n      <div style='background:#f59e0b;color:#000;padding:3px 8px;border-radius:10px;font-size:.72rem;font-weight:700;'>2007</div>\n      <p style='color:#cbd5e1;font-size:.68rem;margin-top:5px;'>第一代 iPhone<br>改變溝通方式</p>\n    </div>\n    <div style='text-align:center;flex:1;'>\n      <div style='font-size:1.7rem;'>📷</div>\n      <div style='background:#f59e0b;color:#000;padding:3px 8px;border-radius:10px;font-size:.72rem;font-weight:700;'>2010</div>\n      <p style='color:#cbd5e1;font-size:.68rem;margin-top:5px;'>Instagram 誕生<br>社群成為日常</p>\n    </div>\n    <div style='text-align:center;flex:1;'>\n      <div style='font-size:1.7rem;'>🗣️</div>\n      <div style='background:#f59e0b;color:#000;padding:3px 8px;border-radius:10px;font-size:.72rem;font-weight:700;'>2016</div>\n      <p style='color:#cbd5e1;font-size:.68rem;margin-top:5px;'>語音助理<br>進入家庭</p>\n    </div>\n    <div style='text-align:center;flex:1;'>\n      <div style='font-size:1.7rem;'>🤖</div>\n      <div style='background:#ef4444;color:#fff;padding:3px 8px;border-radius:10px;font-size:.72rem;font-weight:700;'>2022</div>\n      <p style='color:#cbd5e1;font-size:.68rem;margin-top:5px;'>ChatGPT 發布<br>生成式 AI 爆紅</p>\n    </div>\n    <div style='text-align:center;flex:1;'>\n      <div style='font-size:1.7rem;'>✨</div>\n      <div style='background:#10b981;color:#fff;padding:3px 8px;border-radius:10px;font-size:.72rem;font-weight:700;'>NOW</div>\n      <p style='color:#cbd5e1;font-size:.68rem;margin-top:5px;'>AI 輔助學習<br>已成日常</p>\n    </div>\n  </div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.95rem;margin:0;'>💬 <strong>想一想</strong>：你出生的那一年還沒有 ChatGPT。15 年後你 22 歲，那時的科技會長什麼樣子？你希望它幫你解決什麼問題？</p>\n</div>"}, {"id": 3, "chapter": "第一節：科技怎麼改變生活", "title": "Stay Hungry, Stay Foolish", "bg": "purple", "quiz": null, "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:26px 20px;'>\n  <div style='font-size:3rem;margin-bottom:14px;'>&#10077;</div>\n  <h1 style='font-size:2.1rem;font-weight:900;color:#fff;margin-bottom:12px;'>Stay Hungry, Stay Foolish!</h1>\n  <h2 style='font-size:1.4rem;color:#e9d5ff;font-weight:500;margin-bottom:20px;'>求知若飢，虛心若愚</h2>\n  <p style='color:#d8b4fe;font-size:.9rem;margin-bottom:20px;'>— Steve Jobs，2005 年史丹佛大學畢業典禮演說</p>\n  <div style='background:rgba(255,255,255,.12);border-radius:12px;padding:16px 20px;max-width:640px;margin:0 auto;'>\n    <p style='color:#f3e8ff;font-size:.95rem;line-height:1.9;margin:0;'>\n      保持飢渴地去求知，保持謙遜地去學習。<br>\n      在這堂課，<strong>「我不會」不是丟臉的事，「我不想試」才是</strong>。<br>\n      每一個很厲害的人，都曾經是完全不會的人。</p>\n  </div>\n</div>"}, {"id": 4, "chapter": "第一節：科技怎麼改變生活", "title": "你每天用了幾次資訊科技？", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>資訊科技是什麼？你每天都在用它！</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:12px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.92rem;'><strong>📖 定義</strong>：用於<strong>管理及處理資訊</strong>所採用的各種技術總稱，也稱 <strong>ICT</strong>（Information and Communication Technology，資訊與通訊科技）。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>💬</div><strong style='font-size:.85rem;color:#1e40af;'>人際溝通</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>LINE、Email、視訊課</p></div>\n  <div style='background:#f0fdf4;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>🛒</div><strong style='font-size:.85rem;color:#166534;'>線上購物</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>蝦皮、行動支付</p></div>\n  <div style='background:#fef2f2;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>🏥</div><strong style='font-size:.85rem;color:#991b1b;'>醫療掛號</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>健保快易通</p></div>\n  <div style='background:#fefce8;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>📚</div><strong style='font-size:.85rem;color:#854d0e;'>線上學習</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>YouTube、均一、酷課雲</p></div>\n  <div style='background:#f5f3ff;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>🚌</div><strong style='font-size:.85rem;color:#5b21b6;'>交通生活</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>悠遊卡、公車動態、YouBike</p></div>\n  <div style='background:#ecfeff;padding:12px;border-radius:10px;text-align:center;'>\n    <div style='font-size:1.6rem;'>🎮</div><strong style='font-size:.85rem;color:#155e75;'>娛樂直播</strong>\n    <p style='font-size:.74rem;color:#475569;margin-top:4px;'>YouTube、Twitch</p></div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>🏆 <strong>小挑戰</strong>：從今天早上起床到現在，你用了幾次資訊科技？（提示：鬧鐘也算）和同組同學比比看誰數得最多、最有創意。</p>\n</div>"}, {"id": 5, "chapter": "第一節：科技怎麼改變生活", "title": "資訊科技 vs 生活科技", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>你上的是「科技領域」的哪一半？</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;border-top:5px solid #2563eb;'>\n    <div style='font-size:1.8rem;margin-bottom:6px;'>💻</div>\n    <h3 style='color:#1e40af;font-size:1.05rem;margin-bottom:8px;'>資訊科技（本課）</h3>\n    <ul style='color:#334155;font-size:.85rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>運算思維：把問題拆解、找規律</li>\n      <li>資料處理：搜尋、組織、表達、分析</li>\n      <li>系統平台：電腦怎麼運作、怎麼連網</li>\n      <li>資訊科技與人類社會的關係</li>\n    </ul>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:16px;border-top:5px solid #16a34a;'>\n    <div style='font-size:1.8rem;margin-bottom:6px;'>🔧</div>\n    <h3 style='color:#166534;font-size:1.05rem;margin-bottom:8px;'>生活科技</h3>\n    <ul style='color:#334155;font-size:.85rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>設計與製作：從想法到成品</li>\n      <li>材料與工具：木工、機構、電子</li>\n      <li>科技與工程的實作歷程</li>\n      <li>常與資訊科技合體做專題</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#eff6ff;padding:12px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>💡 兩者都屬於<strong>科技領域</strong>。想做一台「自動澆水的智慧盆栽」？感測器與外殼是生活科技，讀資料、寫程式、上傳雲端是資訊科技——這正是我們第二學期要走的路。</p>\n</div>"}, {"id": 6, "chapter": "第一節：科技怎麼改變生活", "title": "第一節 隨堂測驗", "bg": "purple", "quiz": "q1", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>科技怎麼改變生活 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答，答錯不扣分，看解析最重要！</p>\n</div>"}, {"id": 7, "chapter": "第二節：這學期要探索什麼", "title": "科技新興議題七大主題", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>科技新興議題 — 這學期一起探索的七大主題</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:linear-gradient(135deg,#1e3a8a,#2563eb);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>📡</div><strong style='font-size:.9rem;'>物聯網</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Internet of Things</p></div>\n  <div style='background:linear-gradient(135deg,#065f46,#0d9488);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>📊</div><strong style='font-size:.9rem;'>大數據</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Big Data</p></div>\n  <div style='background:linear-gradient(135deg,#0369a1,#0ea5e9);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>☁️</div><strong style='font-size:.9rem;'>雲端運算</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Cloud Computing</p></div>\n  <div style='background:linear-gradient(135deg,#6b21a8,#a855f7);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>🧠</div><strong style='font-size:.9rem;'>機器學習</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Machine Learning</p></div>\n  <div style='background:linear-gradient(135deg,#9a3412,#f97316);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>🤖</div><strong style='font-size:.9rem;'>人工智慧</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Artificial Intelligence</p></div>\n  <div style='background:linear-gradient(135deg,#7f1d1d,#dc2626);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>🔒</div><strong style='font-size:.9rem;'>資訊安全</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Information Security</p></div>\n  <div style='background:linear-gradient(135deg,#1f2937,#4b5563);color:#fff;border-radius:12px;padding:14px;text-align:center;'>\n    <div style='font-size:1.7rem;'>⚖️</div><strong style='font-size:.9rem;'>資訊倫理</strong>\n    <p style='font-size:.68rem;opacity:.85;margin-top:3px;'>Ethics &amp; Law</p></div>\n  <div style='background:#f1f5f9;border:2px dashed #94a3b8;border-radius:12px;padding:14px;text-align:center;display:flex;flex-direction:column;justify-content:center;'>\n    <div style='font-size:1.4rem;'>🎯</div><strong style='font-size:.8rem;color:#475569;'>專題報告<br>與成果發表</strong></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>💬 這七個主題不是各自獨立的。<strong>IoT 蒐集資料 → 存進雲端 → 變成大數據 → 餵給 AI 學習 → 產生資安與倫理問題</strong>，它們其實是一條線。</p>\n</div>"}, {"id": 8, "chapter": "第二節：這學期要探索什麼", "title": "第一學期學習地圖", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>第一學期學習地圖（第 1–14 週，每週 1 節）</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.82rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:14%;'>週次</th>\n    <th style='padding:7px;text-align:left;width:38%;'>單元主題</th>\n    <th style='padding:7px;text-align:left;'>你會做出什麼</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>W1</td><td style='padding:7px;'>課程導覽與數位公民</td><td style='padding:7px;'>課前問卷、我的科技一天</td></tr>\n  <tr><td style='padding:7px;'>W2</td><td style='padding:7px;'>物聯網 IoT 與 AIoT</td><td style='padding:7px;'>自創 IoT 裝置合作簡報</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>W3</td><td style='padding:7px;'>大數據與雲端運算</td><td style='padding:7px;'>Google 雲端工具介紹＋地圖路線規劃</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>W4</td><td style='padding:7px;'>個人資料保護與數位足跡</td><td style='padding:7px;'>隱私設定自我檢核表</td></tr>\n  <tr style='background:#fefce8;'><td style='padding:7px;'>W5</td><td style='padding:7px;'>數位著作合理使用</td><td style='padding:7px;'>合法素材清單＋為作品選 CC 授權</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>W6</td><td style='padding:7px;'>資訊安全：人是最大的漏洞</td><td style='padding:7px;'>釣魚信件辨識、密碼健檢</td></tr>\n  <tr style='background:#fef2f2;'><td style='padding:7px;'>W7</td><td style='padding:7px;'>Deepfake 與科技倫理</td><td style='padding:7px;'>假影音查證 Group Talk</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>W8–9</td><td style='padding:7px;'>人工智慧與機器學習</td><td style='padding:7px;'>訓練自己的 AI（Teachable Machine）</td></tr>\n  <tr style='background:#f0fdf4;'><td style='padding:7px;'>W10–12</td><td style='padding:7px;'>新興議題專題報告製作</td><td style='padding:7px;'>6 頁以上專題簡報</td></tr>\n  <tr style='background:#f0fdf4;'><td style='padding:7px;'>W13–14</td><td style='padding:7px;'>成果發表</td><td style='padding:7px;'>上台發表＋同儕互評</td></tr>\n</table>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>📌 第二、三學期會接續學習<strong>電腦基本構造、流程圖、演算法與 Scratch 程式設計</strong>，最後做「生活應用發想專題」。這學期先把觀念與工具打底。</p>\n</div>"}, {"id": 9, "chapter": "第二節：這學期要探索什麼", "title": "這門課怎麼評分", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>這門課怎麼評分？（好消息：沒有期末大考）</h2>\n<div style='display:flex;border-radius:10px;overflow:hidden;height:44px;font-size:.85rem;color:#fff;margin-bottom:14px;'>\n  <div style='flex:6;background:#3b82f6;display:flex;align-items:center;justify-content:center;'>實作與作業 60%</div>\n  <div style='flex:2;background:#0d9488;display:flex;align-items:center;justify-content:center;'>隨堂測驗 20%</div>\n  <div style='flex:2;background:#f59e0b;display:flex;align-items:center;justify-content:center;'>學習態度 20%</div>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.9rem;'>📁 實作與作業</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:6px;line-height:1.7;'>每個單元的 Google 簡報、文件、表單作品，以及第 10–14 週的專題與發表。</p></div>\n  <div style='background:#ecfdf5;padding:13px;border-radius:10px;'>\n    <strong style='color:#065f46;font-size:.9rem;'>📝 隨堂測驗</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:6px;line-height:1.7;'>就是這個網站裡的測驗。<strong>答錯不扣分</strong>，看完解析能說出「為什麼」才算數。</p></div>\n  <div style='background:#fffbeb;padding:13px;border-radius:10px;'>\n    <strong style='color:#92400e;font-size:.9rem;'>🤝 學習態度</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:6px;line-height:1.7;'>出席、參與討論、小組貢獻，還有——用完電腦記得關機、椅子推進去。</p></div>\n</div>\n<div style='background:#f5f3ff;padding:12px 16px;border-radius:8px;border-left:4px solid #7c3aed;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>📏 每份作品都用 <strong>A / B / C / D 四級規準</strong>評定，標準寫在首頁的「評量規準」頁——<strong>先看規準再做作業</strong>，是拿 A 最快的方法。</p>\n</div>"}, {"id": 10, "chapter": "第二節：這學期要探索什麼", "title": "課前問卷", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📋 課前問卷：老師想先認識你</h2>\n<div style='background:rgba(255,255,255,.12);border-radius:12px;padding:16px 20px;margin-bottom:12px;'>\n  <p style='color:#ccfbf1;font-size:.92rem;line-height:1.9;margin:0;'>\n    這份問卷<strong>沒有標準答案，也不計分</strong>。老師想知道全班的起點在哪裡，才能把課調整成適合大家的難度。請誠實作答。</p>\n</div>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#fff;font-size:.88rem;'>① 你的裝置經驗</strong>\n    <p style='color:#ccfbf1;font-size:.78rem;margin-top:5px;line-height:1.7;'>家裡有電腦嗎？平常用手機還是平板？打字用注音還是英文鍵盤？</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#fff;font-size:.88rem;'>② 你的軟體經驗</strong>\n    <p style='color:#ccfbf1;font-size:.78rem;margin-top:5px;line-height:1.7;'>用過 Google 簡報／文件嗎？做過報告嗎？寫過程式嗎（Scratch 也算）？</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#fff;font-size:.88rem;'>③ 你的網路習慣</strong>\n    <p style='color:#ccfbf1;font-size:.78rem;margin-top:5px;line-height:1.7;'>一天大約用幾小時 3C？最常用哪些 App？遇過網路上的困擾嗎？</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#fff;font-size:.88rem;'>④ 你的期待</strong>\n    <p style='color:#ccfbf1;font-size:.78rem;margin-top:5px;line-height:1.7;'>這學期你最想學會什麼？對哪個主題最好奇？有什麼想問老師的？</p></div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:11px 16px;margin-top:12px;'>\n  <p style='color:#f0fdfa;font-size:.85rem;margin:0;'>🔗 老師會在課堂上公布 Google 表單連結（或 QR Code）。作答前記得先用<strong>學校帳號</strong>登入。</p>\n</div>"}, {"id": 11, "chapter": "第二節：這學期要探索什麼", "title": "第二節 隨堂測驗", "bg": "purple", "quiz": "q2", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>這學期要探索什麼 ｜ 3 題</p>\n</div>"}, {"id": 12, "chapter": "第三節：把工具準備好", "title": "課程帳號設定", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🔑 課程帳號設定 — 整學期都會用到</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;border-top:5px solid #2563eb;'>\n    <div style='font-size:1.6rem;margin-bottom:6px;'>📧</div>\n    <h3 style='color:#1e40af;font-size:1rem;margin-bottom:8px;'>學校 Google 帳號</h3>\n    <p style='font-size:.82rem;color:#334155;line-height:1.9;margin:0;'>\n      帳號格式：<code style='background:#dbeafe;padding:1px 6px;border-radius:4px;'>學號@fhehs.tp.edu.tw</code><br>\n      用途：Google 表單、雲端硬碟、共同編輯簡報、繳交作業</p>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:16px;border-top:5px solid #16a34a;'>\n    <div style='font-size:1.6rem;margin-bottom:6px;'>🪪</div>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>教育體系單一身分驗證</h3>\n    <p style='font-size:.82rem;color:#334155;line-height:1.9;margin:0;'>\n      帳號格式：<code style='background:#dcfce7;padding:1px 6px;border-radius:4px;'>fhehs＋學號</code><br>\n      用途：登入酷課雲、教育部各項學習平台與資安評量活動</p>\n  </div>\n</div>\n<div style='background:#fef2f2;border-left:4px solid #dc2626;padding:12px 16px;border-radius:8px;'>\n  <strong style='color:#991b1b;font-size:.9rem;'>⚠️ 三個一定要記住的規矩</strong>\n  <ul style='color:#374151;font-size:.85rem;line-height:1.9;margin:6px 0 0;padding-left:20px;'>\n    <li><strong>密碼不告訴任何人</strong>，包含最好的朋友。忘記密碼找老師重設，不要借用別人的帳號。</li>\n    <li>初次登入後<strong>立刻改成自己記得住的密碼</strong>（第 6 週會教怎麼設出好密碼）。</li>\n    <li>用完公用電腦<strong>一定要登出</strong>——這是本學期最常被扣分的地方。</li>\n  </ul>\n</div>"}, {"id": 13, "chapter": "第三節：把工具準備好", "title": "Chromebook 使用方式", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>💻 Chromebook 使用方式 — 六個一定要會的操作</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.88rem;'>① 帳號登入</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>用學校 Google 帳號登入，書籤、雲端硬碟會自動同步到任何一台機器。</p></div>\n  <div style='background:#f0fdf4;padding:13px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.88rem;'>② 輸入法切換</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'><code>Ctrl + 空白鍵</code>切換中英文，或點右下角「US／注音」。</p></div>\n  <div style='background:#fefce8;padding:13px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.88rem;'>③ 截圖</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'><code>Ctrl + Switcher</code>全螢幕；<code>Ctrl + Shift + Switcher</code>框選範圍。交作業超常用！</p></div>\n  <div style='background:#f5f3ff;padding:13px;border-radius:10px;'>\n    <strong style='color:#5b21b6;font-size:.88rem;'>④ 常用快速鍵</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'><code>Ctrl+C</code>複製、<code>Ctrl+V</code>貼上、<code>Ctrl+X</code>剪下、<code>Ctrl+Z</code>復原、<code>Alt+Backspace</code>刪除。</p></div>\n  <div style='background:#ecfeff;padding:13px;border-radius:10px;'>\n    <strong style='color:#155e75;font-size:.88rem;'>⑤ 找應用程式</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>點桌面左下角的「空心小圓點」，可搜尋所有 App。</p></div>\n  <div style='background:#fef2f2;padding:13px;border-radius:10px;'>\n    <strong style='color:#991b1b;font-size:.88rem;'>⑥ 記得登出！</strong>\n    <p style='font-size:.78rem;color:#475569;margin-top:5px;line-height:1.7;'>右下角頭像 →「登出」。不登出，下一個人看得到你的所有資料。</p></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>⌨️ <strong>小技巧</strong>：Chromebook 沒有 Caps Lock 鍵，它的位置是「搜尋鍵」。想開大寫可以按 <code>Alt + 搜尋鍵</code>。</p>\n</div>"}, {"id": 14, "chapter": "第三節：把工具準備好", "title": "這學期的 Google 工具組", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🧰 這學期的 Google 工具組 — 全部免費、全部在雲端</h2>\n<table style='width:100%;border-collapse:collapse;font-size:.83rem;margin-bottom:12px;'>\n  <tr style='background:#1e40af;color:#fff;'>\n    <th style='padding:7px;text-align:left;width:20%;'>工具</th>\n    <th style='padding:7px;text-align:left;width:34%;'>用來做什麼</th>\n    <th style='padding:7px;text-align:left;'>這學期哪一週會用到</th></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📁 雲端硬碟 Drive</td><td style='padding:7px;'>存放所有作業，自動備份不怕電腦壞掉</td><td style='padding:7px;'>整學期</td></tr>\n  <tr><td style='padding:7px;'>📊 簡報 Slides</td><td style='padding:7px;'>做報告、多人同時編輯同一份</td><td style='padding:7px;'>W2、W7、W10–14</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>📄 文件 Docs</td><td style='padding:7px;'>寫學習單、專題企劃、共筆</td><td style='padding:7px;'>W4、W5、W6</td></tr>\n  <tr><td style='padding:7px;'>📋 表單 Forms</td><td style='padding:7px;'>做問卷、自動統計結果</td><td style='padding:7px;'>W1、W13–14 互評</td></tr>\n  <tr style='background:#eff6ff;'><td style='padding:7px;'>🗺️ 地圖 Maps / My Maps</td><td style='padding:7px;'>路線規劃、街景、自製主題地圖</td><td style='padding:7px;'>W3（配合探索課程統整）</td></tr>\n</table>\n<div style='background:#ecfdf5;padding:12px 16px;border-radius:8px;border-left:4px solid #0d9488;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>☁️ <strong>為什麼全部用雲端？</strong>因為<strong>不用存檔</strong>（自動儲存）、<strong>不怕檔案不見</strong>（有版本紀錄可以還原）、<strong>可以多人同時做同一份</strong>。第 3 週會講清楚雲端運算的原理。</p>\n</div>"}, {"id": 15, "chapter": "第三節：把工具準備好", "title": "電腦教室使用規範", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🏫 電腦教室使用規範</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#f0fdf4;border-radius:12px;padding:16px;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>✅ 請這樣做</h3>\n    <ul style='color:#334155;font-size:.84rem;line-height:2;padding-left:18px;margin:0;'>\n      <li>固定座位，方便老師掌握設備狀況</li>\n      <li>發現設備異常<strong>立刻舉手</strong>告訴老師</li>\n      <li>檔案存在<strong>雲端硬碟</strong>，不要只存桌面</li>\n      <li>離開前：關機（或登出）、椅子推進去、垃圾帶走</li>\n    </ul>\n  </div>\n  <div style='background:#fef2f2;border-radius:12px;padding:16px;'>\n    <h3 style='color:#991b1b;font-size:1rem;margin-bottom:8px;'>🚫 請不要這樣</h3>\n    <ul style='color:#334155;font-size:.84rem;line-height:2;padding-left:18px;margin:0;'>\n      <li>飲料、食物帶進電腦教室（鍵盤最怕水）</li>\n      <li>自行插拔線材、更改系統設定</li>\n      <li>登入他人帳號、翻看別人的檔案</li>\n      <li>安裝來路不明的軟體或外掛</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🔧 <strong>設備是大家的</strong>：這間教室一整天會被好幾個班級使用。你怎麼對待鍵盤和椅子，下一節課的同學就會遇到什麼樣的環境。</p>\n</div>"}, {"id": 16, "chapter": "第三節：把工具準備好", "title": "第三節 隨堂測驗", "bg": "purple", "quiz": "q3", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>帳號、Chromebook 與教室規範 ｜ 3 題</p>\n</div>"}, {"id": 17, "chapter": "第四節：成為數位公民", "title": "什麼是數位公民", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🌍 什麼是「數位公民」？</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:12px;border-left:4px solid #0d9488;'>\n  <p style='margin:0;color:#0f172a;font-size:.92rem;'>數位公民（Digital Citizen）＝ 在網路世界裡，<strong>知道自己的權利、也負起自己的責任</strong>的人。你已經是了，只是可能還沒發現。</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;padding:14px;border-radius:10px;'>\n    <strong style='color:#1e40af;font-size:.92rem;'>🛡️ 保護自己</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>設好密碼、管好 App 權限、不隨便給個資、不點來路不明的連結。<br><span style='color:#0d9488;'>→ 第 4、6 週</span></p></div>\n  <div style='background:#f0fdf4;padding:14px;border-radius:10px;'>\n    <strong style='color:#166534;font-size:.92rem;'>🤝 尊重他人</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>不散布別人的照片與私訊、不網路霸凌、使用作品時標明作者。<br><span style='color:#0d9488;'>→ 第 4、5 週</span></p></div>\n  <div style='background:#fefce8;padding:14px;border-radius:10px;'>\n    <strong style='color:#854d0e;font-size:.92rem;'>🔍 判斷資訊</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>看到聳動消息先查證、知道 AI 會說錯話、能分辨真假影音。<br><span style='color:#0d9488;'>→ 第 7、8–9 週</span></p></div>\n  <div style='background:#f5f3ff;padding:14px;border-radius:10px;'>\n    <strong style='color:#5b21b6;font-size:.92rem;'>💡 善用科技</strong>\n    <p style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.8;'>用工具解決真實問題，而不是被工具牽著走。<br><span style='color:#0d9488;'>→ 第 2、3、10–14 週</span></p></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'>\n  <p style='color:#374151;font-size:.9rem;margin:0;'>💬 <strong>一句話檢查法</strong>：發文或轉發之前先想——「這句話，我當著對方的面說得出口嗎？」</p>\n</div>"}, {"id": 18, "chapter": "第四節：成為數位公民", "title": "你的數位足跡", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>👣 數位足跡：你以為刪掉了，其實沒有</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;border-top:5px solid #2563eb;'>\n    <h3 style='color:#1e40af;font-size:1rem;margin-bottom:8px;'>主動足跡</h3>\n    <p style='font-size:.8rem;color:#64748b;margin-bottom:8px;'>你自己「按下送出」留下的</p>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>社群貼文、限時動態、留言</li>\n      <li>上傳的照片與影片</li>\n      <li>填過的問卷、註冊過的網站</li>\n    </ul>\n  </div>\n  <div style='background:#fef2f2;border-radius:12px;padding:16px;border-top:5px solid #dc2626;'>\n    <h3 style='color:#991b1b;font-size:1rem;margin-bottom:8px;'>被動足跡</h3>\n    <p style='font-size:.8rem;color:#64748b;margin-bottom:8px;'>你沒察覺，系統默默記下的</p>\n    <ul style='color:#334155;font-size:.83rem;line-height:1.9;padding-left:18px;margin:0;'>\n      <li>搜尋關鍵字、瀏覽紀錄、Cookie</li>\n      <li>影片看到第幾秒就滑掉</li>\n      <li>手機的定位、Wi-Fi 連線紀錄</li>\n    </ul>\n  </div>\n</div>\n<div style='background:#1e293b;border-radius:10px;padding:14px 18px;margin-bottom:12px;'>\n  <p style='color:#e2e8f0;font-size:.88rem;margin:0;line-height:1.9;'>\n    🧠 <strong style='color:#fbbf24;'>為什麼要在意？</strong>你的被動足跡會被演算法拿去決定「你接下來看到什麼」。滑得越久，它越懂你；越懂你，你越滑不停——這就是第 7 週要談的「<strong>你是在用手機，還是手機在用你？</strong>」</p>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>🔎 <strong>試試看</strong>：用 Google 搜尋自己的名字（加上學校或社團），看看網路上找得到你的哪些資訊。這叫做「自我搜尋（ego search）」，是資安人員的基本功。</p>\n</div>"}, {"id": 19, "chapter": "第四節：成為數位公民", "title": "你的科技一天", "bg": "teal", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>⏰ 你的科技一天 — 從起床到睡覺</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.5rem;'>⏰</div><strong style='color:#fff;font-size:.85rem;'>07:00 起床</strong>\n    <p style='color:#ccfbf1;font-size:.74rem;margin-top:5px;line-height:1.6;'>手機鬧鐘（軟體）<br>順手滑一下社群（演算法開始工作）</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.5rem;'>🚌</div><strong style='color:#fff;font-size:.85rem;'>07:40 上學</strong>\n    <p style='color:#ccfbf1;font-size:.74rem;margin-top:5px;line-height:1.6;'>刷悠遊卡（RFID）<br>查公車動態（IoT＋開放資料）</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.5rem;'>📚</div><strong style='color:#fff;font-size:.85rem;'>13:00 上課</strong>\n    <p style='color:#ccfbf1;font-size:.74rem;margin-top:5px;line-height:1.6;'>Google 簡報共編（雲端運算）<br>查資料（搜尋引擎＋AI）</p></div>\n  <div style='background:rgba(255,255,255,.12);border-radius:10px;padding:13px;'>\n    <div style='font-size:1.5rem;'>🌙</div><strong style='color:#fff;font-size:.85rem;'>21:00 睡前</strong>\n    <p style='color:#ccfbf1;font-size:.74rem;margin-top:5px;line-height:1.6;'>看串流影片（推薦系統）<br>行動支付買東西（資安風險）</p></div>\n</div>\n<div style='background:rgba(0,0,0,.2);border-radius:8px;padding:12px 18px;'>\n  <p style='color:#f0fdfa;font-size:.9rem;margin:0;line-height:1.9;'>\n    🎯 你今天碰過的每一項科技，這學期都會拆開來看它<strong>怎麼運作、有什麼好處、有什麼風險</strong>。<br>\n    科技不是魔法，它是人設計出來的——所以你也可以設計它。</p>\n</div>"}, {"id": 20, "chapter": "第四節：成為數位公民", "title": "第四節 隨堂測驗", "bg": "purple", "quiz": "q4", "chart": null, "video": null, "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>數位公民與數位足跡 ｜ 3 題</p>\n</div>"}, {"id": 21, "chapter": "課堂任務", "title": "課堂任務：我的科技一天", "bg": "white", "quiz": null, "chart": null, "video": null, "html": "\n<h2 class='slide-title'>🎯 課堂任務：我的科技一天</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;margin-bottom:12px;'>\n  <div style='background:#eff6ff;border-radius:12px;padding:16px;'>\n    <h3 style='color:#1e40af;font-size:1rem;margin-bottom:8px;'>📋 任務說明（個人，Google 文件）</h3>\n    <ol style='color:#334155;font-size:.84rem;line-height:2;padding-left:20px;margin:0;'>\n      <li>完成課前問卷（Google 表單）</li>\n      <li>建立一份 Google 文件，命名為<code>座號_姓名_我的科技一天</code></li>\n      <li>列出你<strong>一天中用到的 10 項資訊科技</strong>，寫下時間與用途</li>\n      <li>其中挑 <strong>3 項</strong>，各寫一句「如果它突然消失，我的生活會怎樣？」</li>\n      <li>最後寫一句：<strong>這學期我最想學會的一件事</strong></li>\n      <li>分享給老師（檢視權限即可），或依老師指示繳交</li>\n    </ol>\n  </div>\n  <div style='background:#f0fdf4;border-radius:12px;padding:16px;'>\n    <h3 style='color:#166534;font-size:1rem;margin-bottom:8px;'>📏 評分重點</h3>\n    <table style='width:100%;font-size:.8rem;color:#334155;border-collapse:collapse;'>\n      <tr><td style='padding:5px 0;'><strong style='color:#059669;'>A</strong></td><td>10 項齊全、分類清楚，3 個「如果消失」的推論具體有想法</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#2563eb;'>B</strong></td><td>10 項齊全，推論合理</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#d97706;'>C</strong></td><td>在引導下完成大部分項目</td></tr>\n      <tr><td style='padding:5px 0;'><strong style='color:#dc2626;'>D</strong></td><td>僅完成部分項目</td></tr>\n    </table>\n  </div>\n</div>\n<div style='background:#fef3c7;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'>\n  <p style='color:#374151;font-size:.88rem;margin:0;'>💡 <strong>提示</strong>：別只寫「手機、電腦、平板」——那是裝置不是科技。想想「導航是怎麼知道路況的」「影片為什麼剛好推薦你想看的」，這種才是好答案。</p>\n</div>"}, {"id": 22, "chapter": "課堂任務", "title": "本章重點回顧", "bg": "navy", "quiz": null, "chart": null, "video": null, "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 1 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>資訊科技（IT／ICT）</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>管理與處理資訊的各種技術總稱，你的一天從頭到尾都在用</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>七大主題</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>IoT → 大數據 → 雲端 → 機器學習 → AI → 資安 → 資訊倫理，是一條線</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>帳號安全三規矩</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>密碼不外流、不借用他人帳號、公用電腦一定登出</p></div>\n  <div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'>\n    <strong style='color:#93c5fd;font-size:.9rem;'>數位足跡</strong>\n    <p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>分主動與被動；被動足跡餵養演算法，決定你看到什麼</p></div>\n</div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>科技不是魔法，它是人設計出來的——所以你也可以設計它。</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：把日常物品連上網路的「物聯網 IoT」</p>\n</div>"}]